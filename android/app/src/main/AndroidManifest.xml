<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- [6-7-1 Critical 수정] Release 빌드에서 http 패키지를 통한 백엔드 API
         통신(로그인/사주/타로/소원방/지갑/프리패스 등 핵심 기능 전체)이 가능하도록
         INTERNET 권한을 명시적으로 선언한다. 기존에는 Flutter가 자동 생성하는
         debug/profile AndroidManifest.xml에만 이 권한이 있어(개발용), Release
         APK/AAB에는 누락되어 네트워크가 전면 차단되는 문제가 있었다. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- 07단계(추가) §3.3 - AI 손금 카메라 촬영 기능용 런타임 권한 선언 -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>

    <!-- [Phase C-1] 저녁 7시 종소리 알림용 flutter_local_notifications 20.1.0 설정.
         정확한 시각(초 단위) 정밀도가 필요 없는 "은은한 종소리" 컨셉이므로
         SCHEDULE_EXACT_ALARM/USE_EXACT_ALARM(별도 권한 승인/스토어 심사 이슈)은
         사용하지 않고 zonedSchedule의 inexact 방식(androidScheduleMode: inexact)만
         사용한다. POST_NOTIFICATIONS는 Android 13+에서 알림 표시 자체에 필요하며,
         RECEIVE_BOOT_COMPLETED는 기기 재부팅 후에도 예약이 유지되도록 한다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:label="Fortune Fusion"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- [애드몹 테스트 연동] Google Mobile Ads SDK가 앱 시작 시 요구하는
             APPLICATION_ID meta-data. 아래 값은 구글이 공개 배포한 "테스트용"
             App ID(ca-app-pub-3940256099942544~3347511713)이며, 실제 서비스
             계정과 무관하다. 운영 전환 시 사장님의 실제 애드몹 계정에서
             발급한 App ID로 이 값만 교체하면 된다(AdmobAdIds.androidAppId
             주석 참고). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- [귀인지도 딥링크 버그수정 — Phase A] 카톡 등으로 공유한 초대
                 링크를 열었을 때 실제로 앱이 열리도록 하는 딥링크 수신 설정.

                 [배경] 지금까지 공유 메시지에 박아 넣던 `sintong.app/g/{token}`은
                 실존하지 않는(미등록) 도메인이라, App Links(https)를 등록해도
                 무의미하다(assetlinks.json을 배포할 실제 서버가 없음). 그래서
                 실제 도메인 구매 없이도 지금 당장 동작 가능한 커스텀 URI
                 스킴(`fortunefusion://g/{token}`)을 사용한다. autoVerify(디지털
                 자산 링크 검증)는 커스텀 스킴에는 적용되지 않아 이 샌드박스
                 환경에서도 완전히 테스트 가능하다.

                 [2단계 구조] 카톡 인앱 브라우저는 커스텀 스킴 링크를 직접
                 열면 "지원하지 않는 프로토콜"로 막을 수 있으므로, 실제
                 공유되는 초대 메시지에는 admin_web의 실제 웹 랜딩페이지
                 (https, EnvConfig.adminApiBaseUrl 호스트)를 먼저 넣고, 그
                 페이지 내부의 "앱에서 열기" 버튼이 이 커스텀 스킴으로
                 재호출한다(guinji_share_screen.dart, admin_web
                 src/app/g/[token]/page.tsx 참고).

                 [Phase B, 완료] 운영 도메인 sintong.kr(가비아 g클라우드 서버,
                 1.201.118.72)을 확보하고 아래 3가지를 완료했다:
                   1) DNS A레코드(sintong.kr → 1.201.118.72, 가비아 콘솔)
                   2) Let's Encrypt HTTPS 인증서(certbot, 자동갱신 등록됨)
                   3) https://sintong.kr/.well-known/assetlinks.json 배포
                      (Next.js public/ 폴더는 dotfile을 정적으로 서빙하지
                      않는 제약이 있어 API Route로 구현,
                      src/app/.well-known/assetlinks.json/route.ts)
                 Google Digital Asset Links API로 sintong.kr ↔
                 com.fortunefusion.fortune(release-key.jks SHA256) 소유권
                 매핑이 정상 검증됨을 확인했다. 아래 두 번째 intent-filter가
                 그 https App Links이며, autoVerify="true"로 앱 설치 시
                 Android가 자동으로 도메인 소유권을 검증한다(검증 성공 시
                 카톡 인앱브라우저에서 링크를 클릭해도 중간 웹페이지 없이
                 즉시 앱이 열린다. 검증 전이거나 실패 시에는 기존처럼
                 웹페이지 → "앱에서 열기" 버튼 경로로 자연스럽게 폴백된다). -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="fortunefusion" android:host="g"/>
                <!-- [귀인지도 바이럴 랜딩 - ServiceGrid 신설] 바이럴 랜딩페이지
                     (admin_web `/g/[token]`)의 "소원방/타로/정통사주/오늘의
                     운세" 카드가 누르는 즉시 신통방통 앱의 해당 화면으로
                     바로 이동하도록, 위 `g` host와 별개로 `svc` host를 신규
                     등록한다. `fortunefusion://svc/{key}` 형태이며 key는
                     wish-room|tarot|jeontong|today 중 하나(자세한 매핑은
                     guinji_deep_link_handler.dart 참고). -->
                <data android:scheme="fortunefusion" android:host="svc"/>
            </intent-filter>
            <!-- [Phase B] sintong.kr 운영 도메인 App Links (https).
                 assetlinks.json 검증에 성공하면 https://sintong.kr/g/{token}
                 링크를 클릭한 즉시 앱이 직접 열린다(카톡 인앱브라우저 포함).
                 pathPrefix="/g"로 범위를 제한해, admin_web의 다른 공개
                 페이지(/login, /terms, /privacy-policy, /account-deletion 등)를
                 브라우저에서 열 때는 이 앱이 가로채지 않고 정상적으로
                 웹페이지로 열리도록 한다. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="https"
                    android:host="sintong.kr"
                    android:pathPrefix="/g"/>
                <!-- [귀인지도 바이럴 랜딩 - ServiceGrid 신설] https 경로 버전.
                     https://sintong.kr/svc/{key} 형태(예: /svc/wish-room). -->
                <data
                    android:scheme="https"
                    android:host="sintong.kr"
                    android:pathPrefix="/svc"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- [Phase C-1] flutter_local_notifications 20.1.0이 예약 알림을 실제로
             발화(및 재부팅 후 재예약)하는 데 필요한 리시버. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- [프리패스 "쿠팡 방문하기" 버튼 연동] Android 11(API 30)+ 패키지 가시성
             정책에 따라, url_launcher가 https URL을 처리할 브라우저 앱을 찾으려면
             이 선언이 필요하다. 선언이 없으면 launchUrl()이 조용히 실패하거나
             ActivityNotFoundException을 던져 "버튼을 눌러도 반응 없음" 증상이
             발생할 수 있다. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
        <!-- [귀인지도 SNS 공유 버그수정 — 2026-09] 카톡/SMS/인스타그램 공유
             버튼이 실제로 해당 앱을 열도록 하려면(url_launcher launchUrl),
             Android 11+ 패키지 가시성 정책상 각 스킴을 명시적으로 질의
             선언해야 한다. 선언이 없으면 launchUrl()이 canLaunchUrl() 단계
             에서 false를 반환하거나 조용히 실패해 "버튼을 눌러도 반응
             없음" 증상이 발생한다. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="sms"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="instagram"/>
        </intent>
    </queries>
</manifest>





















