// Prisma schema — Fortune Fusion Admin Web (Phase18-0)
// 기준 문서: 04A_Database_Full_Column_Specification.md 도메인 B(관리자)
// 로컬 개발용 SQLite 사용 (Firebase 미구성으로 인한 대안, 사용자 승인됨)
//
// [설계 결정 메모] 04A는 id를 BIGINT(Snowflake)로 정의하지만, 본 프로젝트는
// 완전히 별도의 로컬 개발 DB(SQLite)이므로 실무적으로 Int autoincrement를 사용한다.
// 컬럼명/제약/의미는 04A와 1:1 매칭하여 설계 충돌이 없도록 한다.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── 04A B-2: admin_roles (마스터) ──────────────────────────────
model AdminRole {
  id        Int       @id @default(autoincrement())
  code      String    @unique // super_admin / operator / cs / content_manager
  name      String
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  adminUsers  AdminUser[]
  permissions AdminPermission[]

  @@map("admin_roles")
}

// ── 04A B-3: admin_permissions ─────────────────────────────────
model AdminPermission {
  id        Int       @id @default(autoincrement())
  roleId    Int       @map("role_id")
  menuCode  String    @map("menu_code")
  canRead   Boolean   @default(false) @map("can_read")
  canWrite  Boolean   @default(false) @map("can_write")
  canDelete Boolean   @default(false) @map("can_delete")
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  role AdminRole @relation(fields: [roleId], references: [id])

  @@unique([roleId, menuCode])
  @@map("admin_permissions")
}

// ── 04A B-1: admin_users ───────────────────────────────────────
model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  name         String
  roleId       Int       @map("role_id")
  is2faEnabled Boolean   @default(false) @map("is_2fa_enabled")
  lastLoginAt  DateTime? @map("last_login_at")
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")

  role            AdminRole       @relation(fields: [roleId], references: [id])
  loginLogs       AdminLoginLog[]
  assignedReports Report[]        @relation("ReportAssignedAdmin")

  @@map("admin_users")
}

// ── 04A B-4: admin_login_logs (Append-only) ────────────────────
model AdminLoginLog {
  id          Int      @id @default(autoincrement())
  adminUserId Int      @map("admin_user_id")
  ipAddress   String   @map("ip_address")
  successFlag Boolean  @map("success_flag")
  createdAt   DateTime @default(now()) @map("created_at")

  adminUser AdminUser @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@map("admin_login_logs")
}

// ════════════════════════════════════════════════════════════════
// Phase18-1: 회원 관리 (05_Admin_System_Design.md §3.1)
// 04A 도메인 A(회원/인증/권한) 중 회원관리 화면에 필요한 5개 테이블만 우선 구현.
// [범위 결정] user_sns_accounts/user_grade_histories/user_interests/
// user_values/user_activity_patterns/user_consents는 04A에 정의되어 있으나
// 현 단계 회원관리 화면(목록/상세/상태변경) 요구사항에 직접 쓰이지 않아
// 절대원칙④·⑤(소단위개발)에 따라 이번 범위에서 제외한다(추후 필요시 추가).
// ════════════════════════════════════════════════════════════════

// ── 04A A-5: user_grades (마스터) ───────────────────────────────
model UserGrade {
  id                  Int       @id @default(autoincrement())
  code                String    @unique // bronze/silver/gold/vip
  name                String
  minActivityScore    Int       @default(0) @map("min_activity_score")
  pointEarnMultiplier Float     @default(1.0) @map("point_earn_multiplier")
  sortOrder           Int       @default(0) @map("sort_order")
  status              String    @default("active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")
  createdBy           String?   @map("created_by")
  updatedBy           String?   @map("updated_by")

  users User[]

  @@map("user_grades")
}

// ── 04A A-1: users ───────────────────────────────────────────────
model User {
  id               Int       @id @default(autoincrement())
  email            String?   @unique
  phone            String?   @unique
  passwordHash     String?   @map("password_hash")
  nickname         String    @unique
  gender           String?
  status           String    @default("active") // active/suspended/withdrawn
  withdrawalReason String?   @map("withdrawal_reason")
  lastLoginAt      DateTime? @map("last_login_at")
  signupChannel    String    @default("app") @map("signup_channel")
  marketingAgreed  Boolean   @default(false) @map("marketing_agreed")
  gradeId          Int?      @map("grade_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")

  grade                         UserGrade?               @relation(fields: [gradeId], references: [id])
  profile                       UserProfile?
  loginLogs                     UserLoginLog[]
  withdrawalLogs                UserWithdrawalLog[]
  wallets                       Wallet[]
  pointHistories                PointHistory[]
  attendances                   Attendance[]
  userMissions                  UserMission[]
  userAchievements              UserAchievement[]
  rankingSnapshots              RankingSnapshot[]
  userAmulets                   UserAmulet[]
  amuletCollections             AmuletCollection[]
  amuletGiftsSent               AmuletGift[]             @relation("AmuletGiftFrom")
  amuletGiftsReceived           AmuletGift[]             @relation("AmuletGiftTo")
  luckybagOpenLogs              LuckybagOpenLog[]
  giftcardIssues                GiftcardIssue[]
  couponIssues                  CouponIssue[]
  communityPosts                CommunityPost[]
  wishes                        Wish[]
  comments                      Comment[]
  reportsSubmitted              Report[]                 @relation("ReportReporter")
  likes                         Like[]
  matchingProfile               MatchingProfile?
  matchingLikesSent             MatchingLike[]           @relation("MatchingLikeFrom")
  matchingLikesReceived         MatchingLike[]           @relation("MatchingLikeTo")
  matchingPairsAsA              MatchingPair[]           @relation("MatchingPairA")
  matchingPairsAsB              MatchingPair[]           @relation("MatchingPairB")
  friendsAsUser                 Friend[]                 @relation("FriendAsUser")
  friendsAsFriend               Friend[]                 @relation("FriendAsFriend")
  followersOf                   Follow[]                 @relation("FollowFollowing") // 나를 팔로우하는 관계(내가 following)
  followingOf                   Follow[]                 @relation("FollowFollower") // 내가 팔로우하는 관계(내가 follower)
  sentChatMessages              ChatMessage[]            @relation("ChatMessageSender")
  compatibilityRequestsSent     CompatibilityRequest[]   @relation("CompatibilityRequestRequester")
  compatibilityRequestsTargeted CompatibilityRequest[]   @relation("CompatibilityRequestTarget")
  payments                      Payment[]
  userSubscriptions             UserSubscription[]
  eventParticipations           EventParticipation[]
  notifications                 Notification[]
  notificationPreferences       NotificationPreference[]
  pushTokens                    PushToken[]
  fortuneRequests               FortuneRequest[]
  consultationSessions          ConsultationSession[]
  passes                        UserPass[]
  luckPouchWallet               LuckPouchWallet?
  luckPouchHistories            LuckPouchHistory[]
  openPassAdRewardLogs          OpenPassAdRewardLog[]
  passCategoryUsages            PassCategoryUsage[]
  fortuneAdWatchLogs            FortuneAdWatchLog[]

  @@map("users")
}

// ── 04A A-2: user_profiles (1:1) ────────────────────────────────
model UserProfile {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique @map("user_id")
  birthDate  String?   @map("birth_date") // 민감정보(암호화 대상), 로컬 개발단계에서는 평문 문자열로 보관
  birthTime  String?   @map("birth_time")
  isLunar    Boolean   @default(false) @map("is_lunar")
  birthPlace String?   @map("birth_place")
  mbti       String?
  introText  String?   @map("intro_text")
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")

  user User @relation(fields: [userId], references: [id])

  @@map("user_profiles")
}

// ── 04A A-4: user_login_logs (Append-only) ──────────────────────
model UserLoginLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  loginType   String   @map("login_type") // email/kakao/google/apple
  ipAddress   String   @map("ip_address")
  deviceInfo  String?  @map("device_info") // JSON 문자열
  successFlag Boolean  @map("success_flag")
  failReason  String?  @map("fail_reason")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("user_login_logs")
}

// ── 04A A-11: user_withdrawal_logs (Append-only) ────────────────
model UserWithdrawalLog {
  id                   Int       @id @default(autoincrement())
  userId               Int       @map("user_id")
  reason               String?
  requestedAt          DateTime  @default(now()) @map("requested_at")
  dataPurgeScheduledAt DateTime  @map("data_purge_scheduled_at")
  dataPurgedAt         DateTime? @map("data_purged_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("user_withdrawal_logs")
}

// ── 04A O-2: operation_logs (Append-only, 관리자 CUD 감사로그) ──
// 05_Admin_System_Design.md 원칙2: "모든 CUD 작업은 예외 없이 operation_logs 기록"
model OperationLog {
  id         Int      @id @default(autoincrement())
  actorType  String   @map("actor_type") // admin/user/system
  actorId    Int?     @map("actor_id")
  action     String // create/update/delete/status_change 등
  targetType String   @map("target_type") // 폴리모픽: user/ai_prompt_template/tarot_card 등
  targetId   Int?     @map("target_id")
  before     String? // JSON 문자열(변경 전 스냅샷)
  after      String? // JSON 문자열(변경 후 스냅샷)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorType, actorId, createdAt])
  @@map("operation_logs")
}

// ════════════════════════════════════════════════════════════════
// Phase18-2: AI 콘텐츠 관리 (05_Admin_System_Design.md §3.2)
// 04A 도메인G(AI 상담/로그/프롬프트) + 도메인E(타로 마스터)의 일부를 구현.
// [범위 결정] 이번 단계에서는 아래 3개 화면만 구현한다(절대원칙④·⑤ 소단위개발):
//  1) 프롬프트 템플릿 목록/버전이력/편집/배포 (ai_prompt_templates)
//  2) AI 호출 로그/비용 대시보드 (ai_request_logs)
//  3) 타로카드/스프레드 마스터 관리 (tarot_cards, tarot_spreads)
// [범위 제외] A/B테스트 설정(05§3.2에 "선택기능, P2"로 명시), 무료/유료 정책 설정
// (리워드관리 point_policies와 함께 다루는 것이 구조적으로 자연스러움, Phase18-3에서 검토),
// 콘텐츠 신고 처리(reports는 커뮤니티관리 3.5와 공유하는 폴리모픽 테이블이라 통합 구현 예정).
// fortune_requests/fortune_results 등 실제 AI 운세 생성 도메인(E-1~E-4,E-7~E-9)은
// 회원 앱 기능 자체이며 관리자 화면 05§3.2 요구사항에 직접 쓰이지 않아 이번 범위에서 제외.
// ════════════════════════════════════════════════════════════════

// ── 04A G-3: ai_prompt_templates (버전 증가, 덮어쓰기 금지) ─────
model AiPromptTemplate {
  id                  Int       @id @default(autoincrement())
  fortuneTypeOrDomain String    @map("fortune_type_or_domain") // saju/daily/tarot/face/palm/consultation/compatibility
  version             Int
  templateBody        String    @map("template_body")
  isActive            Boolean   @default(false) @map("is_active")
  status              String    @default("active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")
  createdBy           String?   @map("created_by")
  updatedBy           String?   @map("updated_by")

  fortuneResults FortuneResult[]

  @@index([fortuneTypeOrDomain, isActive])
  @@map("ai_prompt_templates")
}

// ══════════════════════════════════════════════════════════════════
// 04A 도메인 E "AI 운세 콘텐츠" — E-1/E-2 신규 추가(Phase18-FortuneCore-1)
// [범위 결정] 원칙⑤(소단위 개발): 04A 도메인 E 전체(7테이블) 중, 공통
//   프레임워크의 뼈대인 fortune_requests(E-1)+fortune_results(E-2) 2개만
//   이번 소단위에서 추가한다. 사주/타로/관상/손금 세부 확장 테이블
//   (saju_charts/tarot_draws/face_analyses/palm_analyses, E-3~E-9 중 세부분)과
//   daily_fortunes(E-4)는 각각 별도 소단위로 순차 진행한다(원칙⑦).
//   이 2개 테이블만으로도 05§3.0 라이브운영센터 🟢 위젯 및 05§3.2
//   "운세 결과 조회(조회전용)" 화면 신설의 최소 데이터 기반이 마련된다.
// [소프트 삭제 없음] 04A Base 컬럼 정의상 deleted_at은 모든 테이블에 존재하나,
//   fortune_requests/results는 이력성(append-only에 준함) 데이터로 실무상
//   관리자가 삭제할 근거가 없어(05문서에 CUD 스펙 없음, 조회 전용) deletedAt
//   컬럼은 Base 표준 유지 차원에서 포함하되 애플리케이션 레벨 CUD는 구현하지
//   않는다(조회 전용 화면만 다음 소단위에서 추가).
// ══════════════════════════════════════════════════════════════════

// ── 04A E-1: fortune_requests (※Base 포함, 파티션 대상) ──
model FortuneRequest {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  fortuneType  String    @map("fortune_type") // saju/daily/tarot/face/palm
  inputPayload String    @map("input_payload") // JSONB→String 매핑(SQLite)
  sourceType   String    @default("ai_generated") @map("source_type") // ai_generated/admin_created/external_import
  pointSpent   Int       @default(0) @map("point_spent")
  status       String    @default("pending") // pending/success/failed
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")

  user   User           @relation(fields: [userId], references: [id])
  result FortuneResult?

  @@index([userId, fortuneType, createdAt])
  @@map("fortune_requests")
}

// ── 04A E-2: fortune_results (※Base 포함, UQ(request_id)) ──
model FortuneResult {
  id               Int       @id @default(autoincrement())
  requestId        Int       @unique @map("request_id")
  resultText       String    @map("result_text")
  resultMeta       String?   @map("result_meta") // JSONB→String 매핑(SQLite)
  aiModel          String    @map("ai_model")
  promptTemplateId Int       @map("prompt_template_id")
  promptVersion    Int       @map("prompt_version")
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")

  request        FortuneRequest   @relation(fields: [requestId], references: [id])
  promptTemplate AiPromptTemplate @relation(fields: [promptTemplateId], references: [id])

  @@map("fortune_results")
}

// ── 04A G-4: ai_request_logs (Append-only) ─────────────────────
model AiRequestLog {
  id           Int      @id @default(autoincrement())
  domain       String // saju/tarot/face/palm/consultation/compatibility
  requestRefId Int?     @map("request_ref_id")
  aiModel      String   @map("ai_model")
  latencyMs    Int?     @map("latency_ms")
  tokenUsage   Int?     @map("token_usage")
  costEstimate Float?   @map("cost_estimate")
  status       String // success/failed/timeout
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([domain, createdAt])
  @@map("ai_request_logs")
}

// ══════════════════════════════════════════════════════════════════
// 04A 도메인 G "AI 상담" — G-1/G-2 신규 추가(Phase18-Consultation-1)
// [범위 결정] 원칙⑤(소단위 개발): fortune_requests/results(E-1/E-2)와 동일한
//   패턴으로, 05§3.0.1 💬"AI 상담 진행 건수" 라이브 위젯의 데이터 소스가
//   schema.prisma에 없어 여전히 "준비 중" 상태였던 갭을 해소한다.
//   05§3.2 "관련 04A 테이블"에 consultation_sessions/consultation_messages가
//   나열되어 있으나, 독립된 CRUD 관리자 화면 스펙은 없음(E-1/E-2와 동일하게
//   조회 전용 근거 데이터로만 명시됨) — 별도 화면은 만들지 않는다.
// [소프트 삭제 없음] fortune_requests/results와 동일 사유로 deletedAt 컬럼은
//   Base 표준 유지 차원에서 포함하되, 애플리케이션 레벨 CUD는 구현하지 않는다.
// ════════════════════════════════════════════════════════════════════

// ── 04A G-1: consultation_sessions (※Base 포함) ──
model ConsultationSession {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  type              String // love/career/general/(향후)human_expert
  startedAt         DateTime  @default(now()) @map("started_at")
  endedAt           DateTime? @map("ended_at")
  satisfactionScore Int?      @map("satisfaction_score") // 1~5
  consentToStore    Boolean   @default(false) @map("consent_to_store")
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")

  user     User                  @relation(fields: [userId], references: [id])
  messages ConsultationMessage[]

  @@index([userId, createdAt])
  @@map("consultation_sessions")
}

// ── 04A G-2: consultation_messages (※Base 포함, 파티션 대상) ──
model ConsultationMessage {
  id         Int       @id @default(autoincrement())
  sessionId  Int       @map("session_id")
  sender     String // user/ai
  content    String
  tokenCount Int?      @map("token_count")
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")

  session ConsultationSession @relation(fields: [sessionId], references: [id])

  @@index([sessionId, createdAt])
  @@map("consultation_messages")
}

// ── 04A E-5: tarot_cards (마스터) ───────────────────────────────
model TarotCard {
  id              Int       @id @default(autoincrement())
  name            String    @unique
  imageUrl        String?   @map("image_url") // 04A상 files.id FK지만 이번 로컬DB에서는 URL 문자열로 단순화
  uprightMeaning  String    @map("upright_meaning")
  reversedMeaning String    @map("reversed_meaning")
  arcanaType      String    @map("arcana_type") // major/minor
  sortOrder       Int       @default(0) @map("sort_order")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  createdBy       String?   @map("created_by")
  updatedBy       String?   @map("updated_by")

  @@index([arcanaType])
  @@map("tarot_cards")
}

// ── 04A E-6: tarot_spreads (마스터) ─────────────────────────────
model TarotSpread {
  id         Int       @id @default(autoincrement())
  name       String    @unique
  cardCount  Int       @map("card_count")
  isPremium  Boolean   @default(false) @map("is_premium")
  layoutMeta String    @map("layout_meta") // JSON 문자열: 카드 배치 좌표/의미 매핑
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")

  @@map("tarot_spreads")
}

// ════════════════════════════════════════════════════════════════
// Phase18-3: 리워드 관리 (05_Admin_System_Design.md §3.3) — 1차 소단위
// 04A 도메인C(지갑/포인트) 4개 테이블 전체를 구현한다.
// [범위 결정] 05§3.3의 8개 화면 중 아래 4개만 이번 단계에서 구현(절대원칙④·⑤ 소단위개발):
//  1) 포인트 정책 설정 (point_policies)
//  2) 포인트 조정(수동 지급/회수) (point_histories 신규 레코드 생성, balance 직접수정 금지)
//  3) 포인트 이력 조회 (point_histories 조회 전용)
//  4) 만료 배치 모니터링 (point_expiry_batches 조회 전용)
// 4개 화면 모두 라우트 `/reward/policies` 하위 탭으로 통합 구현
// (08§3.2 라우트매핑표에 `/reward/policies` 1개만 명시되어 있고,
//  /reward/history, /reward/adjust 등 별도 라우트가 정의되어 있지 않음).
// [범위 제외] 출석보상규칙설정/미션관리/업적관리/랭킹시즌관리(04A 도메인D, 8개 테이블) —
// 08§3.2에 `/reward/missions`, `/reward/achievements`, `/reward/ranking`으로
// 이미 별도 라우트가 분리되어 있어 구조적으로도 별도 소단위(Phase18-3-2)로 진행함이 타당.
//
// [설계 결정] "무료/유료 정책 설정"(Phase18-2에서 보류) 재검토 결과:
// point_policies(C-3)는 04A 스펙상 컬럼이 source_type(UQ)/amount/daily_limit/is_active
// 4개뿐이며 지급/차감 "방향"을 구분하는 별도 컬럼이 없다. 그러나 실제 거래 단위인
// point_histories.type이 이미 earn/spend로 방향을 구분하므로, point_policies는
// source_type 네이밍 규칙만으로 두 가지 정책을 하나의 테이블로 문제없이 표현 가능하다:
//  - earn류 source_type (attendance/mission/event 등): amount=지급액, daily_limit=1일 최대 지급횟수
//  - spend류 source_type (ai_saju_request/ai_tarot_request 등, 02§2.4·§3의
//    "기능별 1일 무료횟수 + 초과시 차감포인트" 요구사항 정확히 대응):
//    amount=차감포인트, daily_limit=1일 무료횟수
// → 새 컬럼/새 테이블 신설 없이 04A C-3 스펙을 그대로 사용해 통합 구현한다(설계충돌 없음, 원칙②).
// 정책 관리 화면에서 "정책 유형"을 UI 라벨(적립형/차감형)로만 구분해 보여주고,
// 실제 사용 시점(WalletService.earn/spend)에서 어느 방향으로 적용할지는
// source_type 문자열 자체(하드코딩된 카테고리 목록)로 판별한다.
// ════════════════════════════════════════════════════════════════

// ── 04A C-1: wallets ─────────────────────────────────────────────
model Wallet {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  currencyType    String    @default("POINT") @map("currency_type")
  balance         Int       @default(0) @map("balance") // 원장 합계 캐시값(파생) — 직접 UPDATE 금지, WalletService만 갱신
  balanceSyncedAt DateTime? @map("balance_synced_at")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  createdBy       String?   @map("created_by")
  updatedBy       String?   @map("updated_by")

  user      User           @relation(fields: [userId], references: [id])
  histories PointHistory[]

  @@unique([userId, currencyType])
  @@map("wallets")
}

// ── 04A C-2: point_histories (Append-only) ────────────────────────
model PointHistory {
  id           Int       @id @default(autoincrement())
  walletId     Int       @map("wallet_id")
  userId       Int       @map("user_id")
  amount       Int // +적립/-차감
  type         String // earn/spend
  sourceType   String    @map("source_type") // attendance/mission/community/event/purchase/admin_adjust/refund/expire/ai_saju_request 등
  sourceId     Int?      @map("source_id")
  balanceAfter Int       @map("balance_after") // 처리 후 잔액(스냅샷)
  expireAt     DateTime? @map("expire_at")
  memo         String? // 관리자 수동조정 시 사유 등
  createdAt    DateTime  @default(now()) @map("created_at")

  wallet          Wallet           @relation(fields: [walletId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  giftcardRefunds GiftcardRefund[]

  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
  @@map("point_histories")
}

// ── 신규: economy_config (복주머니 경제 핀조절 레버) ──────────────
// [배경] "Fortune Fusion 마스터 개발 프롬프트" 2부(복주머니 경제 엔진) 철학 이식
// (사용자 승인 - 옵션B: 기존 Provider/Next.js/Prisma 스택 유지, 경제 로직만 이식).
// key-value 구조로 관리자가 대시보드 슬라이더에서 값만 바꾸면 즉시 경제에 반영되도록
// 한다(코드 재배포 없이 튜닝). 최초 시딩 값과 의미:
//   refund_rate            = 0.5  (소모성 서비스 이용 시 즉시 환급률, spend_refund 로직에 사용)
//   send_refund_rate       = 0.5  (포인트 보내기 시 "보낸 사람" 환급률)
//   daily_send_limit       = 200  (1인 1일 포인트 보내기 한도, 인플레이션 방어)
model EconomyConfig {
  key         String   @id
  value       Float
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("economy_config")
}

// ── 04A C-3: point_policies ───────────────────────────────────────
model PointPolicy {
  id         Int       @id @default(autoincrement())
  sourceType String    @unique @map("source_type")
  amount     Int       @default(0) // 기본 지급/차감액(양수로 저장, 방향은 sourceType으로 판별)
  dailyLimit Int?      @map("daily_limit") // 1일 최대 지급 횟수/무료 횟수
  isActive   Boolean   @default(true) @map("is_active")
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")

  @@map("point_policies")
}

// ── 04A C-4: point_expiry_batches (Append-only, 배치 실행 이력) ──
model PointExpiryBatch {
  id                 Int      @id @default(autoincrement())
  targetDate         DateTime @map("target_date")
  expiredAmountTotal Int      @default(0) @map("expired_amount_total")
  processedUserCount Int      @default(0) @map("processed_user_count")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([targetDate])
  @@map("point_expiry_batches")
}

// ════════════════════════════════════════════════════════════════
// Phase18-3-2: 리워드 관리 (05_Admin_System_Design.md §3.3) — 2차 소단위
// 04A 도메인D(출석/미션/업적/랭킹) 8개 테이블 전체를 구현한다.
// [범위 결정] 05§3.3의 나머지 4개 화면을 구현(절대원칙④·⑤ 소단위개발):
//  5) 출석 보상 규칙 설정 (attendance_reward_rules) — attendances는 조회용 이력으로 함께 노출
//  6) 미션 관리 (missions CRUD + user_missions 진행현황 조회)
//  7) 업적 관리 (achievements CRUD, user_achievements는 조회용으로 함께 노출)
//  8) 랭킹 시즌 관리 (ranking_snapshots 조회 + ranking_rewards 보상 설정)
// 08§3.2 라우트매핑표 기준으로 3개 라우트에 분산 구현:
//  - /reward/missions      → 출석보상규칙설정 + 미션관리 (둘 다 "행동 기반 보상" 성격이라 통합)
//  - /reward/achievements  → 업적관리
//  - /reward/ranking       → 랭킹시즌관리
// attendances(D-1)/user_missions(D-4)/user_achievements(D-6)/ranking_snapshots(D-7)는
// 회원 활동 결과 "조회" 대상이므로, Phase18-3의 point_histories 조회 화면과 동일하게
// 조회 전용으로 노출하고 CUD Server Action은 만들지 않는다(회원 앱에서 발생하는 이벤트).
// ════════════════════════════════════════════════════════════════

// ── 04A D-1: attendances (Append-only 성격, UQ(user_id,attend_date)) ──
model Attendance {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  attendDate    DateTime  @map("attend_date")
  streakCount   Int       @default(1) @map("streak_count")
  rewardPoint   Int       @default(0) @map("reward_point")
  bonusItemType String?   @map("bonus_item_type")
  bonusItemId   Int?      @map("bonus_item_id")
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, attendDate])
  @@map("attendances")
}

// ── 04A D-2: attendance_reward_rules (※Base 포함, UQ(streak_day)) ──
model AttendanceRewardRule {
  id            Int       @id @default(autoincrement())
  streakDay     Int       @unique @map("streak_day")
  rewardPoint   Int       @default(0) @map("reward_point")
  bonusItemType String?   @map("bonus_item_type")
  bonusItemId   Int?      @map("bonus_item_id")
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")

  @@map("attendance_reward_rules")
}

// ── 04A D-3: missions (※Base 포함) ──
model Mission {
  id             Int       @id @default(autoincrement())
  title          String
  actionType     String    @map("action_type")
  targetCount    Int       @default(1) @map("target_count")
  rewardPoint    Int       @default(0) @map("reward_point")
  rewardItemType String?   @map("reward_item_type")
  rewardItemId   Int?      @map("reward_item_id")
  periodType     String    @map("period_type") // daily/weekly/achievement
  startAt        DateTime? @map("start_at")
  endAt          DateTime? @map("end_at")
  isActive       Boolean   @default(true) @map("is_active")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")

  userMissions UserMission[]

  @@index([periodType, isActive])
  @@map("missions")
}

// ── 04A D-4: user_missions (※Base 포함, UQ(user_id,mission_id)) ──
model UserMission {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  missionId     Int       @map("mission_id")
  progressCount Int       @default(0) @map("progress_count")
  status        String    @default("in_progress") // in_progress/completed/claimed
  claimedAt     DateTime? @map("claimed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")

  user    User    @relation(fields: [userId], references: [id])
  mission Mission @relation(fields: [missionId], references: [id])

  @@unique([userId, missionId])
  @@index([status])
  @@map("user_missions")
}

// ── 04A D-5: achievements (마스터, ※Base 포함) ──
model Achievement {
  id               Int       @id @default(autoincrement())
  code             String    @unique
  title            String
  conditionType    String    @map("condition_type")
  conditionValue   String    @map("condition_value") // JSON 문자열(조건 파라미터)
  rewardPoint      Int       @default(0) @map("reward_point")
  badgeImageFileId Int?      @map("badge_image_file_id") // 04A상 files.id FK, 로컬DB에서는 참조ID만 보관
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")

  userAchievements UserAchievement[]

  @@map("achievements")
}

// ── 04A D-6: user_achievements (※Base 포함, UQ(user_id,achievement_id)) ──
model UserAchievement {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  achievementId Int       @map("achievement_id")
  achievedAt    DateTime  @default(now()) @map("achieved_at")
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")

  user        User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

// ── 04A D-7: ranking_snapshots (※Base 포함, UQ(ranking_type,period,user_id)) ──
model RankingSnapshot {
  id          Int       @id @default(autoincrement())
  rankingType String    @map("ranking_type") // point/attendance/community_like 등
  period      String // 예: 2025-W07, 2025-03
  userId      Int       @map("user_id")
  rank        Int
  score       Int
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")

  user User @relation(fields: [userId], references: [id])

  @@unique([rankingType, period, userId])
  @@index([rankingType, period, rank])
  @@map("ranking_snapshots")
}

// ── 04A N-7: banners (※Base 포함) ──
// 05_Admin_System_Design.md §3.8 "배너 관리" — cms 메뉴(/cms/banners)에 매핑.
// [스코프 결정] 쿠팡파트너스 등 제휴사 광고 배너를 이 테이블로 관리한다.
//   - link_url: 제휴사(쿠팡파트너스 등) 어필리에이트 링크
//   - image_file_id(04A 원본): 본 로컬DB에서는 TarotCard.imageUrl과 동일한 전례로
//     files 테이블 없이 image_url 문자열로 단순화
//   - display_condition(JSON 조건편집기)은 04A상 popups 전용이라 banners에는 없음 —
//     대신 04A 그대로 position_code/sort_order/start_at/end_at만 사용(가장 쉬운 관리 형태)
//   - 클릭수/노출수 등 통계 컬럼은 04A banners 스펙에 없어 이번 1차 구현에서는 제외
model Banner {
  id           Int       @id @default(autoincrement())
  title        String
  // adType='image'일 때만 사용하는 배너 썸네일 이미지. adType='script'인 경우
  // 제휴사 원본 광고소스(HTML/스크립트)가 이미지를 대신하므로 nullable로 둔다.
  imageUrl     String?   @map("image_url")
  linkUrl      String?   @map("link_url") // 쿠팡파트너스 등 제휴 광고 링크 (adType='image' 전용)
  // 'image': 이미지 URL + 링크(기존 방식) / 'script': 제휴사 원본 광고소스(HTML/iframe/script 태그) 그대로 삽입
  adType       String    @default("image") @map("ad_type")
  // 제휴사가 제공하는 원본 광고 태그(iframe/script). adType='script'일 때 필수.
  // 예) 쿠팡파트너스 <iframe src="https://ads-partners.coupang.com/widgets.html?..."></iframe>
  adScript     String?   @map("ad_script")
  positionCode String    @map("position_code") // home_top/home_middle/home_bottom 등
  sortOrder    Int       @default(0) @map("sort_order")
  isActive     Boolean   @default(true) @map("is_active")
  startAt      DateTime? @map("start_at")
  endAt        DateTime? @map("end_at")
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")

  @@index([positionCode, isActive])
  @@map("banners")
}

// [사용자 요청: "오늘의 행운숫자" 관리자 콘텐츠 - 광고(banners)와 완전히 분리된 별도 모델]
// 홈 화면 "오늘의 행운 리추얼" 배너의 "오늘의 행운 숫자" 카드에 관리자가 이미지/영상/스크립트
// 형태의 콘텐츠를 등록하면 앱에 노출된다. Banner 모델과 스키마 형태는 유사하지만
// (1) "AD" 배지 없음 (2) 광고/제휴 링크 개념 없음 (3) contentType에 'video' 지원
// 이라는 점에서 명확히 다른 용도이므로 별도 테이블로 신설한다(광고 재사용 금지 요청 반영).
model LuckyNumberContent {
  id          Int       @id @default(autoincrement())
  title       String
  // 'image': imageUrl(정지 이미지) / 'video': videoUrl(mp4 등) / 'script': 커스텀 HTML(제휴 아님, 순수 콘텐츠)
  contentType String    @default("image") @map("content_type")
  imageUrl    String?   @map("image_url")
  videoUrl    String?   @map("video_url")
  script      String?
  // 콘텐츠가 없을 때 앱이 폴백으로 보여줄 텍스트(비워두면 daily_fortune의 luckyNumber 사용)
  caption     String?
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  startAt     DateTime? @map("start_at")
  endAt       DateTime? @map("end_at")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")

  @@index([isActive])
  @@map("lucky_number_contents")
}

// [사용자 요청: 홈 "오늘의 운세 이야기" 섹션을 힐링 문구 콘텐츠로 완전 대체]
// 좋은 글귀/힐링 문구/긍정 명언/응원 한마디 등을 관리자가 등록하면, 앱은 활성 문구
// 목록을 통째로 받아 1분마다 하나씩 로컬에서 순환 노출한다(운세 기능과 완전히 무관).
model HealingQuote {
  id        Int       @id @default(autoincrement())
  content   String // 실제로 화면에 노출되는 문구 본문
  author    String? // 출처/저자(선택, 없으면 앱에서 표시하지 않음)
  category  String    @default("healing") @map("category") // healing/quote/encouragement 등 분류 태그(선택 필터용)
  sortOrder Int       @default(0) @map("sort_order")
  isActive  Boolean   @default(true) @map("is_active")
  startAt   DateTime? @map("start_at")
  endAt     DateTime? @map("end_at")
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  @@index([isActive])
  @@map("healing_quotes")
}

// ── 04A D-8: ranking_rewards (※Base 포함) ──
model RankingReward {
  id             Int       @id @default(autoincrement())
  rankingType    String    @map("ranking_type")
  rankRangeMin   Int       @map("rank_range_min")
  rankRangeMax   Int       @map("rank_range_max")
  rewardPoint    Int       @default(0) @map("reward_point")
  rewardItemType String?   @map("reward_item_type")
  rewardItemId   Int?      @map("reward_item_id")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")

  @@index([rankingType])
  @@map("ranking_rewards")
}

// ── 04A H-2: amulet_grades (마스터, ※Base 포함) ──
// 05_Admin_System_Design.md §3.4 "상점 관리" — 디지털부적 상품 관리 1단계(등급 마스터 + 상품)
model AmuletGrade {
  id        Int       @id @default(autoincrement())
  code      String    @unique // common/rare/heroic/legendary
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  amuletItems AmuletItem[]

  @@map("amulet_grades")
}

// ── 04A H-1: amulet_items (※Base 포함) ──
// [스코프 결정] image_file_id(04A 원본, files.id FK)는 TarotCard.imageUrl/Achievement.badgeImageFileId
// 전례와 동일하게 로컬DB에서는 files 테이블 없이 image_url 문자열로 단순화.
// user_amulets 등 지급/보유 이력(H-3~H-6)은 회원 활동 결과 데이터이므로 이번 1단계 범위에서 제외
// (missions 화면의 user_missions 조회전용 패턴과 동일하게 다음 소단위에서 추가 예정).
model AmuletItem {
  id                Int       @id @default(autoincrement())
  name              String
  gradeId           Int       @map("grade_id")
  effectDescription String    @map("effect_description")
  imageUrl          String?   @map("image_url")
  isAiGenerated     Boolean   @default(false) @map("is_ai_generated")
  pricePoint        Int       @default(0) @map("price_point")
  isLimited         Boolean   @default(false) @map("is_limited")
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")

  grade       AmuletGrade        @relation(fields: [gradeId], references: [id])
  userAmulets UserAmulet[]
  collections AmuletCollection[]

  @@index([gradeId])
  @@map("amulet_items")
}

// ── 04A H-3: user_amulets (※Base 포함) ── 조회 전용(회원 활동 결과 데이터)
// status(Base) 사용값: held/used/expired/gifted
model UserAmulet {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  amuletItemId     Int       @map("amulet_item_id")
  acquiredAt       DateTime  @default(now()) @map("acquired_at")
  expiresAt        DateTime? @map("expires_at")
  sourceType       String    @map("source_type") // purchase/event/gift/luckybag
  externalAssetRef String?   @map("external_asset_ref")
  status           String    @default("held")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")

  user       User             @relation(fields: [userId], references: [id])
  amuletItem AmuletItem       @relation(fields: [amuletItemId], references: [id])
  usageLogs  AmuletUsageLog[]
  gifts      AmuletGift[]

  @@index([userId, status])
  @@map("user_amulets")
}

// ── 04A H-4: amulet_usage_logs (Append-only) ── 조회 전용
model AmuletUsageLog {
  id              Int      @id @default(autoincrement())
  userAmuletId    Int      @map("user_amulet_id")
  usedContextType String?  @map("used_context_type") // 폴리모픽(예: fortune_request)
  usedContextId   Int?     @map("used_context_id")
  createdAt       DateTime @default(now()) @map("created_at")

  userAmulet UserAmulet @relation(fields: [userAmuletId], references: [id])

  @@index([userAmuletId])
  @@map("amulet_usage_logs")
}

// ── 04A H-5: amulet_gifts (※Base 포함) ── 조회 전용
model AmuletGift {
  id           Int       @id @default(autoincrement())
  fromUserId   Int       @map("from_user_id")
  toUserId     Int       @map("to_user_id")
  userAmuletId Int       @map("user_amulet_id")
  message      String?
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")

  fromUser   User       @relation("AmuletGiftFrom", fields: [fromUserId], references: [id])
  toUser     User       @relation("AmuletGiftTo", fields: [toUserId], references: [id])
  userAmulet UserAmulet @relation(fields: [userAmuletId], references: [id])

  @@index([fromUserId])
  @@index([toUserId])
  @@map("amulet_gifts")
}

// ── 04A H-6: amulet_collections (※Base 포함, UQ(user_id,amulet_item_id)) ── 조회 전용(도감 진행률)
model AmuletCollection {
  id              Int       @id @default(autoincrement())
  userId          Int       @map("user_id")
  amuletItemId    Int       @map("amulet_item_id")
  firstAcquiredAt DateTime  @default(now()) @map("first_acquired_at")
  totalCount      Int       @default(1) @map("total_count")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  createdBy       String?   @map("created_by")
  updatedBy       String?   @map("updated_by")

  user       User       @relation(fields: [userId], references: [id])
  amuletItem AmuletItem @relation(fields: [amuletItemId], references: [id])

  @@unique([userId, amuletItemId])
  @@map("amulet_collections")
}

// ══════════════════════════════════════════════════════════════════
// 도메인 I. 복주머니 (05§3.4 "복주머니 상품 관리/시즌이벤트/개봉이력")
// ══════════════════════════════════════════════════════════════════

// ── 04A I-2: luckybag_grades (마스터, ※Base 포함) ──
model LuckybagGrade {
  id        Int       @id @default(autoincrement())
  code      String    @unique // none/common/rare/best
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  rewardPools LuckybagRewardPool[]

  @@map("luckybag_grades")
}

// ── 04A I-4: luckybag_seasons (※Base 포함) ──
// [스코프 결정] event_id(04A 원본, FK→events.id nullable)는 events 테이블이 아직
// 스키마에 존재하지 않아 이번 단계에서는 FK 관계 없는 단순 nullable Int 컬럼으로 둔다.
// events 도메인 구현 시 추가 마이그레이션으로 FK 관계를 연결할 예정.
model LuckybagSeason {
  id        Int       @id @default(autoincrement())
  name      String
  startAt   DateTime  @map("start_at")
  endAt     DateTime  @map("end_at")
  eventId   Int?      @map("event_id")
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  products LuckybagProduct[]

  @@index([startAt, endAt])
  @@map("luckybag_seasons")
}

// ── 04A I-1: luckybag_products (※Base 포함) ──
// [스코프 결정] image_file_id는 AmuletItem과 동일한 전례로 image_url 문자열로 단순화.
model LuckybagProduct {
  id         Int       @id @default(autoincrement())
  name       String
  pricePoint Int       @default(0) @map("price_point")
  imageUrl   String?   @map("image_url")
  seasonId   Int?      @map("season_id")
  isActive   Boolean   @default(true) @map("is_active")
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")

  season      LuckybagSeason?      @relation(fields: [seasonId], references: [id])
  rewardPools LuckybagRewardPool[]
  openLogs    LuckybagOpenLog[]

  @@index([seasonId])
  @@map("luckybag_products")
}

// ── 04A I-3: luckybag_reward_pools (※Base 포함) ──
// probability: 그룹(luckybag_product_id 동일 그룹) 합계가 100이 되어야 함 — 애플리케이션 레벨 검증.
model LuckybagRewardPool {
  id                Int       @id @default(autoincrement())
  luckybagProductId Int       @map("luckybag_product_id")
  gradeId           Int       @map("grade_id")
  rewardType        String    @map("reward_type") // point/amulet/giftcard_fragment/none
  rewardRefId       Int?      @map("reward_ref_id") // 폴리모픽(amulet_item_id 등)
  rewardAmount      Int?      @map("reward_amount")
  probability       Float // 0 < probability <= 100, 그룹 합계=100 애플리케이션 검증
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")

  luckybagProduct LuckybagProduct   @relation(fields: [luckybagProductId], references: [id])
  grade           LuckybagGrade     @relation(fields: [gradeId], references: [id])
  openLogs        LuckybagOpenLog[]

  @@index([luckybagProductId])
  @@map("luckybag_reward_pools")
}

// ── 04A I-5: luckybag_open_logs (※Base 포함, 파티션 대상) ── 조회 전용(어뷰징 모니터링)
// status(Base) 사용값: processing/completed/failed
model LuckybagOpenLog {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  luckybagProductId Int       @map("luckybag_product_id")
  rewardPoolId      Int       @map("reward_pool_id")
  rewardResult      String    @map("reward_result") // JSON 문자열 스냅샷(SQLite에는 네이티브 JSONB 없음)
  externalAssetRef  String?   @map("external_asset_ref")
  status            String    @default("completed")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")

  user            User               @relation(fields: [userId], references: [id])
  luckybagProduct LuckybagProduct    @relation(fields: [luckybagProductId], references: [id])
  rewardPool      LuckybagRewardPool @relation(fields: [rewardPoolId], references: [id])

  @@index([userId, createdAt])
  @@map("luckybag_open_logs")
}

// ══════════════════════════════════════════════════════════════════
// 도메인 J. 상품권 (05§3.4 "상품권 상품 관리") — 1차 소단위: giftcard_products
// [범위 결정] 원칙⑤(소단위 개발)에 따라 이번 단계는 상품(재고 포함) CRUD까지만 다룬다.
// giftcard_issues~expiry_logs(J-2~J-7, 생명주기)와 coupons/coupon_issues(J-8/J-9)는
// 다음 소단위에서 순서대로 추가한다(amulet_items -> user_amulets 분할 전례와 동일 방식).
// ══════════════════════════════════════════════════════════════════

// ── 04A J-1: giftcard_products (※Base 포함) ──
// [스코프 결정] image_file_id(04A 원본, files.id FK)는 AmuletItem/LuckybagProduct와
// 동일한 전례로 image_url 문자열로 단순화.
// stock_count CHECK(>=0)는 SQLite datasource+Prisma 조합에서 DB 레벨 CHECK 제약을
// 직접 선언할 수 없어(다른 숫자 컬럼과 동일 전례), zod에서 min(0) 검증 + 애플리케이션
// 레벨에서만 음수 방지를 보장한다(원자적 감소는 J-2 발급 로직 구현 시 트랜잭션으로 처리 예정).
model GiftcardProduct {
  id            Int       @id @default(autoincrement())
  name          String
  brand         String
  requiredPoint Int       @map("required_point")
  stockCount    Int       @default(0) @map("stock_count") // CHECK(stock_count>=0) — 애플리케이션 레벨 검증
  validDays     Int       @default(365) @map("valid_days") // 발급일로부터 유효기간(일)
  imageUrl      String?   @map("image_url")
  isActive      Boolean   @default(true) @map("is_active")
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")

  issues GiftcardIssue[]

  @@index([brand])
  @@index([isActive])
  @@map("giftcard_products")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.4 "상품권 생명주기 조회" — 2차 소단위: J-2~J-7 조회 전용 통합 구현
// [범위 결정] 이번 단계는 "생명주기 조회"(조회 전용) 화면만 구현한다.
// "상품권 환불/재발급 처리"(2단계 확인 필수, 포인트 자동 복원)는 05§3.4상
// 별도 화면으로 명시되어 있으므로, 실제 admin이 취소/환불/재발급을 "처리"하는
// Server Action(쓰기)은 다음 소단위에서 구현한다. 이번 단계는 issues~expiry_logs
// 각 이력 테이블을 조회 전용으로 노출하며, 시딩 데이터로 각 상태 전이를 보여준다.
// ══════════════════════════════════════════════════════════════════

// ── 04A J-2: giftcard_issues (※Base 포함) ── 조회 전용
// status(Base) 사용값: requested/issued/failed/cancelled/expired
// [스코프 결정] issued_code(04A 원본 "암호화" 컬럼)는 로컬 개발 DB에서는 평문 문자열로 단순화.
model GiftcardIssue {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  productId  Int       @map("product_id")
  pointSpent Int       @map("point_spent") // 거래시점 가격 스냅샷
  issuedCode String?   @map("issued_code") // 발급된 쿠폰코드/바코드(로컬DB 평문 단순화)
  issuedAt   DateTime? @map("issued_at")
  expiresAt  DateTime? @map("expires_at")
  status     String    @default("requested")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")

  user         User                @relation(fields: [userId], references: [id])
  product      GiftcardProduct     @relation(fields: [productId], references: [id])
  usage        GiftcardUsage?
  cancels      GiftcardCancel[]
  expiryLogs   GiftcardExpiryLog[]
  reissuesFrom GiftcardReissue[]   @relation("GiftcardReissueOriginal")
  reissuesTo   GiftcardReissue[]   @relation("GiftcardReissueNew")

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("giftcard_issues")
}

// ── 04A J-3: giftcard_usages (※Base 포함, UQ(issue_id)) ── 조회 전용
model GiftcardUsage {
  id               Int       @id @default(autoincrement())
  issueId          Int       @unique @map("issue_id")
  usedAt           DateTime  @default(now()) @map("used_at")
  usedLocationMeta String?   @map("used_location_meta") // JSON 문자열(SQLite 네이티브 JSONB 없음)
  status           String    @default("active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")

  issue GiftcardIssue @relation(fields: [issueId], references: [id])

  @@map("giftcard_usages")
}

// ── 04A J-4: giftcard_cancels (※Base 포함) ── 조회 전용
model GiftcardCancel {
  id            Int       @id @default(autoincrement())
  issueId       Int       @map("issue_id")
  reason        String?
  cancelledAt   DateTime  @default(now()) @map("cancelled_at")
  refundedPoint Int       @map("refunded_point")
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")

  issue   GiftcardIssue    @relation(fields: [issueId], references: [id])
  refunds GiftcardRefund[]

  @@index([issueId])
  @@map("giftcard_cancels")
}

// ── 04A J-5: giftcard_refunds (※Base 포함) ── 조회 전용
// status(Base) 사용값: pending/completed/failed
model GiftcardRefund {
  id                   Int       @id @default(autoincrement())
  cancelId             Int       @map("cancel_id")
  refundPointHistoryId Int       @map("refund_point_history_id")
  status               String    @default("pending")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")
  createdBy            String?   @map("created_by")
  updatedBy            String?   @map("updated_by")

  cancel             GiftcardCancel @relation(fields: [cancelId], references: [id])
  refundPointHistory PointHistory   @relation(fields: [refundPointHistoryId], references: [id])

  @@index([cancelId])
  @@map("giftcard_refunds")
}

// ── 04A J-6: giftcard_reissues (※Base 포함) ── 조회 전용
model GiftcardReissue {
  id              Int       @id @default(autoincrement())
  originalIssueId Int       @map("original_issue_id")
  newIssueId      Int       @map("new_issue_id")
  reason          String?
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  createdBy       String?   @map("created_by")
  updatedBy       String?   @map("updated_by")

  originalIssue GiftcardIssue @relation("GiftcardReissueOriginal", fields: [originalIssueId], references: [id])
  newIssue      GiftcardIssue @relation("GiftcardReissueNew", fields: [newIssueId], references: [id])

  @@index([originalIssueId])
  @@map("giftcard_reissues")
}

// ── 04A J-7: giftcard_expiry_logs (Append-only) ── 조회 전용
model GiftcardExpiryLog {
  id        Int      @id @default(autoincrement())
  issueId   Int      @map("issue_id")
  expiredAt DateTime @default(now()) @map("expired_at")
  createdAt DateTime @default(now()) @map("created_at")

  issue GiftcardIssue @relation(fields: [issueId], references: [id])

  @@index([issueId])
  @@index([expiredAt])
  @@map("giftcard_expiry_logs")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.4 "쿠폰 관리" — 7차 소단위: J-8/J-9 쿠폰 CRUD/발급
// ══════════════════════════════════════════════════════════════════

// ── 04A J-8: coupons (※Base 포함) ──
model Coupon {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  discountType  String    @map("discount_type") // rate/fixed_point
  discountValue Float     @map("discount_value")
  validFrom     DateTime  @map("valid_from")
  validTo       DateTime  @map("valid_to")
  usageLimit    Int?      @map("usage_limit") // 전체 사용 가능 횟수(NULL=무제한)
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")

  issues CouponIssue[]

  @@index([validTo])
  @@map("coupons")
}

// ── 04A J-9: coupon_issues (※Base 포함) ──
// status(Base) 사용값: unused/used/expired
model CouponIssue {
  id        Int       @id @default(autoincrement())
  couponId  Int       @map("coupon_id")
  userId    Int       @map("user_id")
  issuedAt  DateTime  @default(now()) @map("issued_at")
  usedAt    DateTime? @map("used_at")
  status    String    @default("unused")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  coupon Coupon @relation(fields: [couponId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, status])
  @@index([couponId])
  @@map("coupon_issues")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.5 "커뮤니티 관리" — 1차 소단위: L-1/L-2/L-3 게시판/게시글/소원 관리
// [범위 결정] 원칙⑤(소단위 개발): 05§3.5 6개 화면 중 "게시판 관리"(community_boards
//   CRUD) + "게시글/소원 관리"(community_posts, wishes 목록/숨김/삭제) 2개 화면을
//   1차 소단위로 함께 구현한다. 게시판이 있어야 게시글 관리 화면이 의미를 가지므로
//   같은 소단위로 진행(상점관리 1차 소단위=amulet_grades+amulet_items 패턴과 동일).
//   댓글(L-4)/신고처리(L-6)/좋아요통계(L-5)/파일관리(L-7)는 이후 소단위에서 순차 구현.
// ══════════════════════════════════════════════════════════════════

// ── 04A L-1: community_boards (마스터, ※Base 포함) ──
model CommunityBoard {
  id          Int       @id @default(autoincrement())
  code        String    @unique // free/saju_share/tarot_share 등
  name        String
  description String?
  sortOrder   Int       @default(0) @map("sort_order")
  isPublic    Boolean   @default(true) @map("is_public")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")

  posts CommunityPost[]

  @@map("community_boards")
}

// ── 04A L-2: community_posts (※Base 포함) ──
// status(Base) 사용값: visible/blinded/deleted_by_admin
// [스코프 결정] linked_fortune_result_id(04A 원본, fortune_results.id FK)는 fortune_results
// 테이블이 이번 프로젝트 범위 밖(회원 앱 AI 운세 생성 도메인, Phase18-2 주석에서 이미 제외
// 결정됨)이라 이번 소단위에서 함께 제외한다. like_count/comment_count는 04A 명시대로
// 캐시(비정규화) 컬럼으로 스키마에는 유지하되, 실제 갱신 로직(likes/comments 연동)은
// 각각 L-5/L-4 소단위에서 구현할 예정이므로 이번 단계에서는 0으로 고정.
model CommunityPost {
  id           Int       @id @default(autoincrement())
  boardId      Int       @map("board_id")
  userId       Int       @map("user_id")
  title        String
  content      String
  likeCount    Int       @default(0) @map("like_count")
  commentCount Int       @default(0) @map("comment_count")
  isPinned     Boolean   @default(false) @map("is_pinned")
  status       String    @default("visible")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")

  board CommunityBoard @relation(fields: [boardId], references: [id])
  user  User           @relation(fields: [userId], references: [id])

  @@index([boardId, createdAt])
  @@map("community_posts")
}

// ── 04A L-3: wishes (※Base 포함) ──
model Wish {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  content          String
  category         String // health/wealth/love/exam 등
  isAnonymous      Boolean   @default(false) @map("is_anonymous")
  supportCount     Int       @default(0) @map("support_count")
  // [Phase6-2 - 커뮤니티 실API 연동] Flutter WishPostModel.goalTag(nullable) 대응.
  // 04A 원본에는 없던 필드이나, wish_post_model.dart 주석에 "필요 시점에 nullable
  // 필드만 추가하면 되므로 지금 신설하지 않음"이라 명시돼 있어 이번 소단위에서 추가한다.
  goalTag          String?   @map("goal_tag")
  status           String    @default("visible")
  // [소원성(Wish Castle) 확장] 기존 wishes/support API 시그니처는 그대로 유지하고
  // nullable/default 필드만 추가한다(하위호환 100%). "복주머니"는 기존
  // support_count(단순 응원 on/off 토글)와는 별개의 신규 개념 - 실제 포인트 이동이
  // 없는 상징적 응원 단위이며 누적치를 bokjuCount에 별도로 캐시한다.
  candleLevel      Int       @default(0) @map("candle_level") // 0~4 촛불 성장 레벨(서버 계산 캐시)
  bokjuCount       Int       @default(0) @map("bokju_count") // 누적 복주머니(소원성 전용, 포인트 아님)
  isMilestoneShown Boolean   @default(false) @map("is_milestone_shown") // 최종단계 특별연출 1회 노출 플래그
  achievedAt       DateTime? @map("achieved_at") // 최종레벨(레벨4) 도달 시각(여정 타임라인용)
  // [재화 구조 정리 §복주머니 사용 구간표] 글쓴이 자신의 소원에 LuckPouchRule
  // (actionType=highlight/expose_boost, target_scope=wish_board)을 소비해 적용하는
  // 프리미엄 자기개선 액션. null이면 미적용.
  highlightedUntil DateTime? @map("highlighted_until") // 글 강조(필드 강조+배지) 만료 시각
  boostedAt        DateTime? @map("boosted_at") // 노출 강화(피드 상단 재노출) 적용 시각
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")

  user         User         @relation(fields: [userId], references: [id])
  bokjuHistory WishBokju[]
  reviews      WishReview[]

  @@index([category, createdAt])
  @@map("wishes")
}

// ══════════════════════════════════════════════════════════════════
// [소원성(Wish Castle) 확장] 기존 wishes/comments/likes 원자단위는 그대로 두고
// 신규 테이블 3개만 추가한다(기존 스키마 무영향). economy_config와 동일한
// key-value 패턴으로 관리자가 CMS에서 촛불 레벨 임계값/보상/문구/애니메이션
// ON-OFF를 즉시 반영할 수 있게 한다.
// ══════════════════════════════════════════════════════════════════

// 복주머니 발송 이력(Append-only) - 소원 하나당 다건, 실제 포인트 이동 없음
model WishBokju {
  id        Int      @id @default(autoincrement())
  wishId    Int      @map("wish_id")
  userId    Int      @map("user_id")
  amount    Int // 1/5/10/50/100
  source    String   @default("manual") // "manual" | "comment_reward" | "ai_cheer"
  createdAt DateTime @default(now()) @map("created_at")

  wish Wish @relation(fields: [wishId], references: [id])

  @@index([wishId])
  @@map("wish_bokju")
}

// 소원성 관리자 설정(key-value) - economy_config 패턴 재사용
model WishConfig {
  key         String   @id
  value       String // 문자열로 저장(숫자/불리언/JSON 배열 문구 모두 커버)
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  @@map("wish_config")
}

// 성취 후기(신규 기능) - 소원이 최종 레벨에 도달한 뒤 작성하는 후기
model WishReview {
  id         Int      @id @default(autoincrement())
  wishId     Int      @map("wish_id")
  userId     Int      @map("user_id")
  content    String
  isFeatured Boolean  @default(false) @map("is_featured") // 명예의 전당 수동 선정 플래그
  status     String   @default("visible")
  createdAt  DateTime @default(now()) @map("created_at")

  wish Wish @relation(fields: [wishId], references: [id])

  @@index([wishId])
  @@map("wish_reviews")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.5 "커뮤니티 관리" — 2차 소단위: L-4 댓글 관리(comments, 폴리모픽)
// [범위 결정] 원칙⑤(소단위 개발): 05§3.5 "댓글 관리 | comments(폴리모픽) 목록/삭제"
//   스펙을 그대로 구현. 신고처리(L-6)/좋아요통계(L-5)/파일관리(L-7)는 다음 소단위.
// ══════════════════════════════════════════════════════════════════

// ── 04A L-4: comments (폴리모픽, ※Base 포함) ──
// [설계 결정] 04A L-4 원본에는 status 사용값이 명시되어 있지 않으나, 05§3.5 화면
//   스펙이 community_posts/wishes(L-2/L-3, 노출/숨김/삭제 3단계)와 달리 "목록/삭제"
//   만 명시하므로(숨김 기능 없음), comments의 status는 active/deleted_by_admin
//   2단계만 사용한다(원칙② 설계충돌 없음: Base status 컬럼의 "도메인별 상이" 허용
//   범위 내이며, 화면 기능 요구사항 차이를 그대로 반영한 결정).
// [폴리모픽 제약] targetType은 04A 명시대로 post/wish 화이트리스트로 애플리케이션
//   레벨(zod enum)에서 검증한다. Prisma에서 폴리모픽 FK는 표현할 수 없으므로
//   targetId는 단순 Int 컬럼으로 두고, 조회 시 targetType에 따라
//   CommunityPost/Wish를 애플리케이션 레벨에서 분기 조회하여 조합한다
//   (04A상 reports/likes/files도 동일한 폴리모픽 패턴이며 이번 comments가
//   이 프로젝트에서 최초로 구현되는 폴리모픽 테이블).
model Comment {
  id             Int       @id @default(autoincrement())
  targetType     String    @map("target_type") // post/wish (화이트리스트 검증)
  targetId       Int       @map("target_id")
  userId         Int       @map("user_id")
  content        String
  status         String    @default("active") // active/deleted_by_admin (2단계, 위 설계결정 참조)
  // [재화 구조 정리 §복주머니 사용 구간표] targetType=wish 댓글 전용 유상 리액션 누적 카운트.
  // LuckPouchRule(actionType=cheer/empathize, target_scope=wish_board)의 amount만큼
  // 차감하고 이 카운터를 +1 한다(무료 Like 토글과 별개의 "소모형" 리액션이라 되돌릴 수
  // 없으므로 Like 테이블 재사용 대신 단순 누적 카운터로 관리한다).
  cheerCount     Int       @default(0) @map("cheer_count")
  empathizeCount Int       @default(0) @map("empathize_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")

  user User @relation(fields: [userId], references: [id])

  @@index([targetType, targetId])
  @@map("comments")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.5 "커뮤니티 관리" — 3차 소단위: L-6 신고 처리함(reports, 폴리모픽)
// ══════════════════════════════════════════════════════════════════

// ── 04A L-6: reports (폴리모픽, ※Base 포함) — v1.1: assigned_admin_id 추가 ──
// [설계 결정 1: status 값 불일치 해결] 04A L-6 명시값(pending/reviewed/actioned)과
//   05§4.1 워크플로우 서술(resolved/rejected)이 서로 다른 상태값을 언급하여
//   원칙②(설계충돌코드금지) 위반 소지가 있음. 04A가 데이터 스펙의 원천(Source of
//   Truth)이므로 04A 3개 값을 그대로 채택하고, 여기에 05§4.1이 요구하는 "반려"
//   결과를 표현하기 위해 rejected 1개 값만 추가하여 4단계로 확장한다:
//     - pending   : 신고 접수 직후(기본값), 담당자 미배정 또는 배정되었으나 미검토
//     - reviewed  : 담당자가 배정되어 검토를 시작한 상태(조치/반려 결정 전)
//     - actioned  : 조치(삭제/경고/계정정지 중 1개 이상) 완료 — 05§4.1 "resolved"에 대응
//     - rejected  : 반려(신고 기각) — 05§4.1 "rejected"와 동일 명칭으로 그대로 채택
//   즉 05§4.1의 resolved는 04A의 actioned로 재해석하고, rejected는 04A에 신규
//   추가한다. Base status 컬럼의 "도메인별 상이" 허용범위 내의 결정이며, 근거를
//   이 주석에 명시하여 원칙② 준수를 보장한다.
// [설계 결정 2: target_type 화이트리스트 — v1.2 갭 해소] 04A 명시값은
//   post/comment/wish/user/fortune_result 5종. 최초 구현 시점에는 fortune_result가
//   fortune_results 테이블 부재로 제외되었으나(v1.1 주석 참조), Phase18-FortuneCore-1
//   소단위에서 fortune_requests/fortune_results(04A E-1/E-2)를 신규 추가하였으므로
//   배제 근거가 해소되어 04A 명시 5종 전체로 화이트리스트를 확장한다
//   (05§3.2 "콘텐츠 신고 처리 | reports(target_type=fortune_result) 목록/처리"
//   요구사항을 이제 충족). target_type=fortune_result인 경우 target_id는
//   fortune_results.id를 참조하며, 조회 시 FortuneResult+FortuneRequest를
//   배치조회하여 신고 대상 텍스트(resultText 일부)를 라벨로 표시한다.
// [설계 결정 3: 조치(action) 처리 범위] 원칙⑤(소단위 개발)에 따라 이번 소단위는
//   report 자체의 상태전이 + 담당자배정 + 최소한의 실제 연동조치만 다룬다:
//     - action="deleted"  : target_type이 post/comment/wish인 경우, 대상 레코드의
//       status를 기존 관리자 페이지(community.ts/comments.ts)와 동일하게
//       "deleted_by_admin"으로 실제 연동 변경한다(이미 구현된 로직 재사용).
//       target_type=user인 경우 "삭제" 액션은 선택 불가(대상이 사용자 자체이므로).
//     - action="suspended": 대상 사용자(target_type=user면 target_id 자신, 그 외
//       타입이면 해당 콘텐츠 작성자)의 users.status를 "suspended"로 변경한다
//       (users 테이블에 04A A-1 기준 이미 존재하는 필드를 재사용).
//     - action="warned"   : 경고 조치는 별도 알림/경고카운트 도메인(05§3.9 알림
//       관리, 미구현)과 연계되어야 완전한 기능이나, 이번 소단위 스코프에서는
//       operation_logs에 조치 사실만 기록하고 users/콘텐츠 테이블 변경은 하지
//       않는다(알림 발송은 05§4.1에도 "선택"으로 명시되어 있어 이번 스코프 제외).
//     - status="rejected" (반려) 시에는 action=null로 두고 대상에는 어떤 변경도
//       가하지 않는다.
//   조치 실행 시 operation_logs 자동 기록은 05§4.1 요구사항을 그대로 반영한다.
// [폴리모픽 제약] target_type은 위 화이트리스트로 애플리케이션 레벨(zod enum)에서
//   검증하며, 조회 시 target_type별로 CommunityPost/Comment/Wish/User를
//   배치 조회하여 조합한다(comments 소단위에서 확립한 패턴 재사용).
// [reporter_id / assigned_admin_id] 04A 명시대로 reporter_id는 FK→users.id(신고자),
//   assigned_admin_id는 FK→admin_users.id(nullable, 05§6 요구사항 반영, v1.1 추가).
model Report {
  id              Int       @id @default(autoincrement())
  targetType      String    @map("target_type") // post/comment/wish/user/fortune_result (화이트리스트, 05§3.2 명시)
  targetId        Int       @map("target_id")
  reporterId      Int       @map("reporter_id")
  reason          String
  assignedAdminId Int?      @map("assigned_admin_id")
  action          String?   @map("action") // null/deleted/warned/suspended (조치 완료 시만 기록 — 위 설계결정 3)
  status          String    @default("pending") // pending/reviewed/actioned/rejected (위 설계결정 1)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  createdBy       String?   @map("created_by")
  updatedBy       String?   @map("updated_by")

  reporter      User       @relation("ReportReporter", fields: [reporterId], references: [id])
  assignedAdmin AdminUser? @relation("ReportAssignedAdmin", fields: [assignedAdminId], references: [id])

  @@index([targetType, targetId])
  @@index([status])
  @@map("reports")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.5 "커뮤니티 관리" — 4차 소단위: L-5 좋아요 통계(likes, 폴리모픽)
// ══════════════════════════════════════════════════════════════════

// ── 04A L-5: likes (폴리모픽, ※Base 포함, UQ(target_type,target_id,user_id)) ──
// [범위 결정] 05§3.5 화면 스펙: "좋아요 통계 | likes(폴리모픽) 집계 조회(어뷰징
//   패턴 탐지용)". comments(L-4)/reports(L-6)와 달리 CUD 기능이 전혀 명시되지
//   않고 "집계 조회"만 명시되어 있으므로(좋아요 등록/취소는 회원 앱 전용 기능),
//   원칙⑤(소단위 개발)에 따라 이번 소단위는 Server Action 없이 순수 읽기 전용
//   페이지만 구현한다(reward/ranking의 "조회 전용" 섹션 패턴과 동일).
// [target_type 화이트리스트] 04A 명시대로 post/wish/comment 3종만 사용한다
//   (reports의 화이트리스트와 달리 user/fortune_result는 대상이 아님 — 좋아요는
//   콘텐츠에 대한 반응이므로 회원 자체에는 적용되지 않는 개념).
// [status 컬럼] 04A Base 표준컬럼에 포함되나, likes는 UQ(target_type,target_id,
//   user_id) 제약과 "누르기/취소" 토글 특성상 회원 앱에서 행 자체를 delete하는
//   것이 자연스러운 도메인이다(04A에 별도 status 사용값 명시 없음). 관리자 화면은
//   "집계 조회"만 다루므로 status 필드는 Base 표준대로 유지하되(기본값 active)
//   실질적으로 사용하지 않는다(향후 회원 앱 구현 시 결정 필요 — 이번 스코프 밖).
model Like {
  id         Int       @id @default(autoincrement())
  targetType String    @map("target_type") // post/wish/comment (화이트리스트, 위 설계결정 참조)
  targetId   Int       @map("target_id")
  userId     Int       @map("user_id")
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")

  user User @relation(fields: [userId], references: [id])

  @@unique([targetType, targetId, userId])
  @@index([targetType, targetId])
  @@map("likes")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.5 "커뮤니티 관리" — 5차(마지막) 소단위: L-7 파일/업로드 관리(files, 폴리모픽 공용)
// [범위 결정] 05§3.5 스펙: "파일/업로드 관리 | files(폴리모픽 공용) 조회, 문제
//   이미지 삭제" — CUD 중 삭제만 명시(업로드/생성은 회원 앱 기능이므로 관리자
//   화면 제외, comments/likes 소단위와 동일 원칙).
// [설계 결정 1: 기존 image_file_id 단순화 결정과의 관계] 이 프로젝트에서는
//   TarotCard/AmuletItem/GiftcardProduct/LuckybagProduct 등 여러 테이블에서
//   04A상 files.id를 참조하는 image_file_id를 로컬DB 단순화를 위해 image_url
//   문자열 컬럼으로 대체해왔다(각 모델 주석 참조). 이번 File 모델 신설은 이
//   결정과 충돌하지 않는다(원칙② 준수): 05§3.5가 요구하는 것은 각 도메인
//   테이블의 이미지 필드 자체가 아니라, **04A L-7 files 테이블을 대상으로 하는
//   별도의 독립 관리자 화면**이다. 즉 이번 소단위는 "파일 업로드 이력을 조회하고
//   문제 있는 파일을 관리자가 직접 삭제 처리"하는 화면으로, 기존 단순화된
//   image_url 필드들과는 별개로 04A L-7 스펙을 그대로 구현한다.
// [설계 결정 2: owner_type 화이트리스트] 04A L-7 명시 예시 4종(user_profile/
//   community_post/amulet_item/banner)을 화이트리스트로 채택한다("등"으로
//   개방형 표기되어 있으나, reports/comments 소단위에서 확립한 전례대로 04A에
//   명시된 값만 화이트리스트로 삼는다).
// [설계 결정 3: owner_id FK 미설정] 04A L-7 원본 표에는 owner_id에 FK 표시가
//   없다(target_type/target_id 폴리모픽 구조의 reports/likes/comments와 동일한
//   패턴이나, files는 owner_id가 Y(nullable)로 명시되어 있어 owner 미지정
//   파일(예: 업로드 직후 아직 연결 전)도 허용한다). Prisma 레벨에서도 FK 관계를
//   맺지 않고 단순 Int? 컬럼으로 둔다.
// [조회/삭제 전용] 05§3.5 스펙대로 목록 조회 + status를 deleted_by_admin으로
//   변경하는 소프트 삭제 Server Action만 구현한다(comments.ts와 동일한 2단계
//   status: active/deleted_by_admin).
model File {
  id        Int       @id @default(autoincrement())
  ownerType String    @map("owner_type") // user_profile/community_post/amulet_item/banner (화이트리스트)
  ownerId   Int?      @map("owner_id") // 04A 명시대로 nullable, FK 미설정
  fileUrl   String    @map("file_url")
  fileType  String    @map("file_type") // image/video
  size      Int?
  status    String    @default("active") // active/deleted_by_admin
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  @@index([ownerType, ownerId])
  @@map("files")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.6 "매칭/궁합 관리" — 1차 소단위: M-1 매칭 프로필 모니터링(matching_profiles)
// [범위 결정] 05§3.6 화면 스펙: "매칭 프로필 모니터링 | matching_profiles 조회,
//   부적절 프로필 강제 비활성화". 04A M-1은 UQ(user_id) 1:1 관계이며 CUD 중
//   "생성"은 회원 앱 전용 기능(매칭 프로필 등록)이므로, comments/likes/files와
//   동일 원칙에 따라 이번 소단위는 목록 조회 + 관리자 강제 비활성화 Server Action만
//   구현한다(preferences/intro_text 자체의 수정 기능은 제공하지 않음 — 회원이
//   직접 관리하는 콘텐츠이며 관리자 화면 스펙에도 "조회, 강제 비활성화"만 명시).
// [설계 결정: is_public vs status] 04A M-1의 is_public(BOOLEAN)은 회원이 스스로
//   설정하는 "매칭 공개 여부"이고, 05§3.6이 요구하는 "부적절 프로필 강제
//   비활성화"는 관리자가 개입하는 별도의 상태 전환이다. 두 개념은 스코프가 다르므로
//   (원칙② 설계충돌 방지) is_public 값은 그대로 유지하고, Base 표준 status
//   컬럼을 active/deactivated_by_admin 2단계로 사용하여 관리자 조치를 별도
//   기록한다(files의 active/deleted_by_admin과 동일 패턴, "비활성화"이므로
//   "deleted"가 아닌 "deactivated"로 명명).
// [preferences JSONB] SQLite에는 네이티브 JSONB가 없으므로(기존 reward_result/
//   used_location_meta와 동일 전례) JSON 문자열로 저장하는 String? 컬럼으로 둔다.
model MatchingProfile {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique @map("user_id")
  isPublic    Boolean   @default(true) @map("is_public")
  preferences String?   @map("preferences") // JSON 문자열(SQLite 네이티브 JSONB 없음) — 이상형 조건 등
  introText   String?   @map("intro_text")
  status      String    @default("active") // active/deactivated_by_admin (부적절 프로필 강제 비활성화)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")

  user User @relation(fields: [userId], references: [id])

  @@map("matching_profiles")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.6 "매칭/궁합 관리" — 2차 소단위: M-2/M-3 매칭 성사 이력
//   (matching_likes, matching_pairs, 조회 전용)
// [범위 결정] 05§3.6 화면 스펙: "매칭 성사 이력 | matching_likes, matching_pairs
//   조회(어뷰징/신고 연계)" — "조회"만 명시(CUD 없음). 매칭 좋아요 발송/매칭
//   성사 자체는 회원 앱 전용 기능이므로(1차 소단위 matching_profiles와 동일
//   원칙), 이번 소단위는 likes(4차 소단위, community/likes)와 동일하게 Server
//   Action 없이 순수 읽기 전용 페이지만 구현한다.
// [M-2 matching_likes] UQ(from_user_id,to_user_id) 조합 — 04A 명시대로 두 개의
//   users FK를 갖는 비폴리모픽 구조이나, 동일 User 모델을 양방향으로 참조하므로
//   Prisma 네이밍된 관계(@relation 이름 지정)가 필요하다(fromUser/toUser).
// [M-3 matching_pairs] UQ(user_a_id,user_b_id) 조합, status(Base) 사용값
//   active/unmatched(04A 명시). matched_at은 04A 원본 컬럼명 그대로 별도
//   필드로 둔다(Base created_at과는 의미가 다름 — 매칭이 "성사"된 시각).
model MatchingLike {
  id         Int       @id @default(autoincrement())
  fromUserId Int       @map("from_user_id")
  toUserId   Int       @map("to_user_id")
  type       String    @default("normal") // normal/super(향후 유료 확장)
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")

  fromUser User @relation("MatchingLikeFrom", fields: [fromUserId], references: [id])
  toUser   User @relation("MatchingLikeTo", fields: [toUserId], references: [id])

  @@unique([fromUserId, toUserId])
  @@map("matching_likes")
}

model MatchingPair {
  id        Int       @id @default(autoincrement())
  userAId   Int       @map("user_a_id")
  userBId   Int       @map("user_b_id")
  matchedAt DateTime  @default(now()) @map("matched_at")
  status    String    @default("active") // active/unmatched (04A 명시)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  userA     User       @relation("MatchingPairA", fields: [userAId], references: [id])
  userB     User       @relation("MatchingPairB", fields: [userBId], references: [id])
  chatRooms ChatRoom[] // 4차 소단위(채팅 모니터링)에서 역참조

  @@unique([userAId, userBId])
  @@map("matching_pairs")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.6 "매칭/궁합 관리" — 3차 소단위: M-4/M-5 친구/팔로우 모니터링
//   (friends, follows, "선택, 조회 전용" 명시 → Server Action 없이 조회
//   전용 페이지만 구현. matching_likes/matching_pairs 2차 소단위와 동일
//   원칙 적용)
// [M-4 friends] UQ(user_id,friend_user_id) 조합, 동일 User 모델 양방향
//   참조이므로 Prisma 네이밍된 관계 필요(user/friendUser).
//   [핵심 차이점] 이전 소단위들(matching_profiles/matching_likes/
//   matching_pairs)의 status 컬럼은 "관리자 액션 기록용"으로 Base 표준
//   컬럼을 재사용(예: active/deactivated_by_admin)한 것이었으나, M-4의
//   status는 04A에 이미 실제 애플리케이션 레벨의 친구관계 상태값
//   (requested/accepted/blocked)으로 명시되어 있어 별도 재정의가
//   필요 없다(원칙② 설계충돌 방지 — 04A 원본 의미 그대로 사용).
// [M-5 follows] UQ(follower_id,following_id) 조합, 동일 User 모델
//   양방향 참조이므로 Prisma 네이밍된 관계 필요(follower/following).
//   04A에 status 사용값이 별도 명시되어 있지 않으므로 Base 기본값
//   "active"를 그대로 사용한다(단순 팔로우 관계 — unfollow는 레코드
//   삭제 또는 deletedAt 처리로 표현될 것으로 예상, 관리자는 조회만).
model Friend {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  friendUserId Int       @map("friend_user_id")
  status       String    @default("requested") // requested/accepted/blocked (04A 명시, 실제 관계상태)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")

  user       User @relation("FriendAsUser", fields: [userId], references: [id])
  friendUser User @relation("FriendAsFriend", fields: [friendUserId], references: [id])

  @@unique([userId, friendUserId])
  @@map("friends")
}

model Follow {
  id          Int       @id @default(autoincrement())
  followerId  Int       @map("follower_id")
  followingId Int       @map("following_id")
  status      String    @default("active") // 04A 별도 명시 없음 — Base 기본값 그대로 사용
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")

  follower  User @relation("FollowFollower", fields: [followerId], references: [id])
  following User @relation("FollowFollowing", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@map("follows")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.6 "매칭/궁합 관리" — 4차 소단위: M-6/M-7 채팅 모니터링
//   (chat_rooms, chat_messages, "신고된 대화만 열람" 사생활 보호 원칙,
//   평시 비열람)
// [설계 충돌 검토 및 해결 — 원칙② 준수] 05§3.6은 "신고된 대화만 열람"을
//   요구하나, 04A L-6 reports.target_type 화이트리스트(post/comment/wish/
//   user, fortune_result 제외 — Report 모델 설계결정2)에는 chat_room/
//   chat_message가 포함되어 있지 않다. 즉 "채팅 자체를 신고 대상으로
//   지정"하는 04A 스키마상의 직접 경로는 존재하지 않는다.
//   → 04A 원본 스키마를 확장(target_type에 chat_room 추가)하는 것은 이번
//     소단위 범위를 넘어서는 문서 변경이므로(원칙① 설계문서기반개발 위반
//     소지) 채택하지 않는다.
//   → 대신 이미 존재하는 target_type=user 신고를 매개로 간접 연결한다:
//     신고당한 회원(reports.target_id, target_type=user)이 참여한
//     matching_pairs(관리자 3차 소단위에서 구현됨) → 그 pair의
//     related_pair_id로 연결된 chat_rooms만 "신고 관계자 대화방"으로
//     페이지에 노출한다. 04A/05 두 문서 모두 수정 없이 그대로 준수하며,
//     "열람 후보"를 관리자에게 보여주고 실제 신고 내용과의 관련성 판단은
//     관리자가 최종 수행하는 방식으로 사생활 보호 원칙을 지킨다(평시에는
//     신고 없는 대화방은 이 화면에 전혀 노출되지 않음).
// [M-6 chat_rooms] type(matching/friend, 04A 명시), related_pair_id는
//   nullable FK→matching_pairs.id(friend 타입 채팅방은 매칭쌍과 무관하므로
//   nullable 그대로 유지).
// [M-7 chat_messages] room_id/sender_id FK, message_type(text/image/system,
//   04A 명시 기본값 text). "파티션 대상"은 04A상 대규모 운영 시 파티셔닝
//   전략 표시이며, 현재 개발 단계 SQLite 스키마에는 영향 없음(주석으로만
//   기록, 실제 파티션 DDL은 이번 스코프 제외).
model ChatRoom {
  id            Int       @id @default(autoincrement())
  type          String // matching/friend (04A 명시)
  relatedPairId Int?      @map("related_pair_id")
  status        String    @default("active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  createdBy     String?   @map("created_by")
  updatedBy     String?   @map("updated_by")

  relatedPair MatchingPair? @relation(fields: [relatedPairId], references: [id])
  messages    ChatMessage[]

  @@map("chat_rooms")
}

model ChatMessage {
  id          Int       @id @default(autoincrement())
  roomId      Int       @map("room_id")
  senderId    Int       @map("sender_id")
  content     String
  messageType String    @default("text") @map("message_type") // text/image/system (04A 명시)
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")

  room   ChatRoom @relation(fields: [roomId], references: [id])
  sender User     @relation("ChatMessageSender", fields: [senderId], references: [id])

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.6 "매칭/궁합 관리" — 5차 소단위: F-3 궁합 요소 가중치 설정
//   (compatibility_factor_weights)
// [범위 결정] 05§3.6 화면 스펙: "궁합 요소 가중치 설정 | compatibility_
//   factor_weights(사주/MBTI/취미/가치관/활동패턴 다차원 가중치) — 정책
//   수치를 관리자가 직접 조정 가능, 04A F도메인 설계 취지 반영" — §3.6의
//   6개 화면 중 유일하게 write(Server Action)가 필요한 화면이다(나머지
//   5개는 조회 전용 또는 조회+강제조치 수준).
// [타입 매핑] 04A 명시 타입 DECIMAL(3,2) → Prisma Float로 매핑한다(기존
//   UserGrade.pointEarnMultiplier가 동일 DECIMAL(3,2)→Float 전례를 이미
//   확립했으므로 이번에도 동일 패턴 재사용, SQLite에는 네이티브 DECIMAL이
//   없음).
// [factor_type 화이트리스트] 04A 명시값 5종: saju/mbti/interest/value/
//   activity_pattern, UQ 제약(회원당이 아닌 전역 단일 정책 레코드이므로
//   factor_type 자체가 유일해야 함).
// [weight 검증] 04A 명시: "가중치(합 1.00 권장, 애플리케이션 검증)" —
//   "권장"이라는 표현이므로 강제(hard constraint)가 아닌 경고 수준으로
//   구현한다(활성(is_active=true) 상태인 항목들의 weight 합계가 1.00에서
//   벗어나면 UI상 경고 배지만 표시하고 저장 자체를 막지는 않음 — 04A 원문의
//   "권장" 표현을 그대로 존중, 원칙② 설계충돌 방지).
// [is_active] 04A 명시 기본값 true. 특정 요소를 궁합 계산에서 임시
//   제외하고자 할 때 사용(레코드 삭제 대신 비활성화로 표현).
model CompatibilityFactorWeight {
  id         Int       @id @default(autoincrement())
  factorType String    @unique @map("factor_type") // saju/mbti/interest/value/activity_pattern (04A 명시 화이트리스트)
  weight     Float // DECIMAL(3,2)→Float 매핑(UserGrade.pointEarnMultiplier 전례), 합 1.00 권장(애플리케이션 경고 수준 검증)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")

  @@map("compatibility_factor_weights")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.6 "매칭/궁합 관리" — 6차(마지막) 소단위: F-1/F-2 궁합 요청/결과 통계
//   (compatibility_requests, compatibility_results)
// [범위 결정] 05§3.6 화면 스펙: "궁합 요청/결과 통계 | compatibility_requests,
//   compatibility_results 집계" — "집계"만 명시(CUD 없음). 궁합 요청 생성/AI
//   결과 산출 자체는 회원 앱 + AI 엔진 전용 기능이므로(이전 조회전용
//   소단위들과 동일 원칙), Server Action 없이 순수 집계/조회 페이지만
//   구현한다. 이것으로 §3.6 매칭/궁합 관리 전체 6개 화면이 완료된다.
// [F-1 compatibility_requests] requester_user_id는 FK→users(NN), target_user_id는
//   FK→users(Y, 상대가 회원인 경우만). target_input(JSONB, 비회원 상대 정보)은
//   SQLite에 네이티브 JSONB가 없으므로 다른 JSON 컬럼들(MatchingProfile.
//   preferences 등)과 동일하게 String(JSON 문자열)으로 매핑한다. type은
//   04A 명시 화이트리스트 love/friend/business/family.
// [F-2 compatibility_results] request_id는 FK→compatibility_requests.id,
//   UQ(1:1 관계 — 요청 1건당 결과 최대 1건). score(INT, 0~100), detail은
//   요소별(사주/mbti/관심사/가치관) 세부점수 JSONB → String(JSON 문자열)
//   매핑(target_input과 동일 원칙).
// [FK 방향] requester_user_id는 NN이므로 필수 관계, target_user_id는
//   nullable이므로 optional 관계로 선언한다. 두 필드 모두 동일 User
//   모델을 참조하므로 named relation 필요(requester/targetUser).
model CompatibilityRequest {
  id              Int       @id @default(autoincrement())
  requesterUserId Int       @map("requester_user_id")
  targetUserId    Int?      @map("target_user_id")
  targetInput     String?   @map("target_input") // JSON 문자열: 비회원 상대 정보(이름/생년월일시 등, 최소수집)
  type            String // love/friend/business/family (04A 명시)
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")
  createdBy       String?   @map("created_by")
  updatedBy       String?   @map("updated_by")

  requester  User                 @relation("CompatibilityRequestRequester", fields: [requesterUserId], references: [id])
  targetUser User?                @relation("CompatibilityRequestTarget", fields: [targetUserId], references: [id])
  result     CompatibilityResult?

  @@index([requesterUserId, createdAt])
  @@map("compatibility_requests")
}

model CompatibilityResult {
  id        Int       @id @default(autoincrement())
  requestId Int       @unique @map("request_id")
  score     Int // 0~100 (04A 명시)
  detail    String // JSON 문자열: 요소별(사주/mbti/관심사/가치관) 세부 점수
  status    String    @default("active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  request CompatibilityRequest @relation(fields: [requestId], references: [id])

  @@map("compatibility_results")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.7 "결제/구독 관리" — 1차 소단위: K-1 결제 내역 조회 (payments)
// ══════════════════════════════════════════════════════════════════

// ── 04A K-1: payments (※Base 포함, ⚠️삭제 절대 금지 원칙, 파티션 대상) ──
// [범위 결정] 05§3.7 화면 스펙: "결제 내역 조회 | payments — 조회 전용,
//   삭제 버튼 자체를 UI에서 제공하지 않음(04A K도메인 '삭제 절대 금지'
//   원칙의 UI 레벨 강제)". 04A 원문 절대원칙 3번("결제/포인트는 관리자
//   화면에서도 직접 수정 절대 금지 — 조회 전용 + '조정 요청'은 반드시
//   별도 이력 레코드 생성 방식으로만 허용")과 정확히 일치하므로, 이번
//   소단위는 Server Action을 전혀 두지 않는다(원칙② 설계충돌 방지 —
//   두 문서 모두 "조회 전용"을 강하게 명시, 애매함 없음).
// [deleted_at 미사용 원칙] 04A 명시: "deleted_at 컬럼은 존재하되
//   애플리케이션 레벨에서 사용 금지(정책적 무시)". Base 표준 컬럼
//   세트를 그대로 두되(deletedAt 필드는 존재), 조회 로직에서
//   `where: { deletedAt: null }` 필터를 절대 사용하지 않는다(다른 모든
//   소단위와 다른 유일한 예외 — soft delete 자체가 이 테이블에는
//   존재하지 않는 정책). 소프트 삭제 자체가 봉인된 필드이므로 UI에서도
//   삭제 버튼을 제공하지 않는다(이미 원칙에서 명시).
// [order_type 화이트리스트] 04A 명시 4종: subscription/giftcard/amulet/
//   luckybag. order_ref_id는 폴리모픽 참조(user_subscriptions.id 등)이나
//   04A가 FK 제약을 명시하지 않았으므로(타입별로 참조 테이블이 다름)
//   Prisma 관계 없이 순수 Int? 컬럼으로만 둔다(폴리모픽 관계는 04A의
//   다른 폴리모픽 테이블들(reports/likes/comments)과 동일 원칙 재사용).
// [pg_tx_id UQ] PG사 거래ID 중복 방지(멱등성 보장).
// [status 사용값] 04A 명시: paid/failed/cancelled.
model Payment {
  id           Int       @id @default(autoincrement())
  userId       Int       @map("user_id")
  orderType    String    @map("order_type") // subscription/giftcard/amulet/luckybag (04A 명시 화이트리스트)
  orderRefId   Int?      @map("order_ref_id") // 폴리모픽 참조(user_subscriptions.id 등) — FK 미설정(대상 테이블이 타입별로 다름)
  amount       Int
  currencyCode String    @default("KRW") @map("currency_code")
  pgProvider   String    @map("pg_provider") // toss/iamport 등
  pgTxId       String    @unique @map("pg_tx_id")
  status       String    @default("paid") // paid/failed/cancelled (04A 명시)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at") // ⚠️04A 명시: 애플리케이션 레벨에서 사용 금지(정책적 무시) — 조회 필터에 절대 사용하지 않음
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")

  user    User            @relation(fields: [userId], references: [id])
  refunds PaymentRefund[]

  @@index([userId, createdAt])
  @@index([orderType])
  @@map("payments")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.7 "결제/구독 관리" — 2차 소단위: K-2 환불 처리 (payment_refunds)
// ══════════════════════════════════════════════════════════════════

// ── 04A K-2: payment_refunds (※Base 포함) ──────────────────────────
// [범위 결정] 05§3.7 화면 스펙: "환불 처리 | payment_refunds 신규 생성
//   워크플로우(원본 payments는 상태만 변경)". 04A 절대원칙3("결제/포인트는
//   관리자 화면에서도 직접 수정 절대 금지 — 조회 전용 + '조정 요청'은
//   반드시 별도 이력 레코드 생성 방식으로만 허용")에 따라, 원본 payments
//   레코드의 amount/pg_tx_id 등 핵심 필드는 절대 직접 수정하지 않고,
//   ① payment_refunds에 새 이력 레코드를 생성 ② 원본 payments.status만
//   paid → cancelled로 전환하는 2단계 방식으로만 환불을 반영한다
//   (K-1 schema.prisma 주석과 동일 원칙의 연장 적용 — 설계충돌 없음).
// [status 사용값] 04A 명시: pending/completed/failed.
// [RBAC 2단계 승인 구조] 05§5.2: "결제/구독 관리 | operator: R(+환불요청,
//   최종승인은 super_admin)". 이는 RBAC_MATRIX.payments={read:true,
//   write:false}만으로는 표현할 수 없는 "예외적 부분 write 권한"이므로,
//   reports.ts의 canWriteReports 전용 헬퍼 패턴을 재사용하여 이 파일
//   전용의 2개 헬퍼를 신설한다(Server Action 파일에서 구현):
//   - canRequestRefund(roleCode): super_admin/operator 허용(환불 요청
//     생성=status:pending) — cs/content_manager는 payments가 R 또는 X이므로
//     제외.
//   - canApproveRefund(roleCode): super_admin만 허용(status:pending→
//     completed 전이 + 원본 payments.status→cancelled 반영).
//   operator가 생성한 pending 건을 super_admin이 승인/거부하는 2단계
//   워크플로우로, 04A가 명시한 "별도 이력 레코드 생성 방식" 원칙과
//   05§5.2의 "최종승인은 super_admin" 제약을 모두 만족한다.
model PaymentRefund {
  id          Int       @id @default(autoincrement())
  paymentId   Int       @map("payment_id")
  amount      Int
  reason      String?
  status      String    @default("pending") // pending/completed/failed (04A 명시)
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("payment_refunds")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.7 "결제/구독 관리" — 3차 소단위: K-3 구독 플랜 관리 (subscription_plans)
// ══════════════════════════════════════════════════════════════════

// ── 04A K-3: subscription_plans (※Base 포함) ───────────────────────
// [범위 결정] 05§3.7 화면 스펙: "구독 플랜 관리 | subscription_plans
//   CRUD(가격/기간/혜택)". K-1/K-2와 달리 이 화면은 §3.7에서 유일하게
//   완전 CRUD(생성/수정/삭제 포함)가 명시되어 있다. RBAC_MATRIX.payments가
//   이미 {super_admin: RWD, operator: R, cs: R, content_manager: X}로
//   설정되어 있으므로(K-1 소단위 커밋에서 확인), 표준 canWriteMenu/
//   canDeleteMenu(payments) 헬퍼를 그대로 사용한다(K-2의 canRequestRefund/
//   canApproveRefund 같은 별도 예외 헬퍼 불필요 — operator는 CRUD 시도 시
//   canWriteMenu가 자동으로 false를 반환하여 거부됨, 설계충돌 없음).
// [period 화이트리스트] 04A 명시 2종: monthly/yearly.
// [benefits JSONB] SQLite에는 JSONB가 없으므로 04A B계열 폴리모픽 처리
//   전례(reports.before/after 등)와 동일하게 String으로 매핑하고
//   애플리케이션 레벨에서 JSON.stringify/parse한다.
// [is_active] 04A 명시: BOOLEAN NN default true, IDX.
model SubscriptionPlan {
  id        Int       @id @default(autoincrement())
  name      String
  price     Int
  period    String // monthly/yearly (04A 명시 화이트리스트)
  benefits  String // JSON 배열/객체 문자열(04A JSONB → SQLite String 매핑)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  userSubscriptions UserSubscription[]

  @@index([isActive])
  @@map("subscription_plans")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.7 "결제/구독 관리" — 4차 소단위: K-4 구독 현황 조회 (user_subscriptions)
// ══════════════════════════════════════════════════════════════════

// ── 04A K-4: user_subscriptions (※Base 포함) ───────────────────────
// [범위 결정] 05§3.7 화면 스펙: "구독 현황 조회 | user_subscriptions
//   조회, 강제 해지(사유 필수)". K-3(완전CRUD)와 달리 이 화면은 "조회 +
//   제한적 write 1건(강제해지)"만 명시되어 있다.
// [사유 필수 처리] 04A user_subscriptions 테이블에는 취소사유 전용 컬럼이
//   없다(payments/payment_refunds처럼 reason 컬럼이 명시돼 있지 않음).
//   K-1~K-3에서 이미 모든 변경작업을 operation_logs.before/after에
//   기록해온 전례와 동일하게, 강제해지 사유는 별도 컬럼 신설 없이
//   operationLog.after에 포함하여 기록한다(설계 확장이 아닌 기존 로깅
//   패턴의 재사용 — 04A 스키마 변경 없이 05 화면 요구사항 충족).
// [status 화이트리스트] 04A 명시 4종: active/cancelled/expired/past_due.
// [FK] user_id→users.id, plan_id→subscription_plans.id.
// [UQ] pg_subscription_id(nullable unique).
// [IDX] (user_id, status) 복합, current_period_end.
model UserSubscription {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  planId           Int       @map("plan_id")
  status           String    @default("active") // active/cancelled/expired/past_due (04A 명시)
  startedAt        DateTime  @default(now()) @map("started_at")
  currentPeriodEnd DateTime  @map("current_period_end")
  pgSubscriptionId String?   @unique @map("pg_subscription_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")

  user User             @relation(fields: [userId], references: [id])
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId, status])
  @@index([currentPeriodEnd])
  @@map("user_subscriptions")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.8 "CMS" — 2차 소단위: 팝업 관리 (popups)
// ══════════════════════════════════════════════════════════════════

// ── 04A N-8: popups (※Base 포함) ────────────────────────────────────
// [범위 결정] 05§3.8 화면 스펙: "팝업 관리 | popups CRUD(노출 조건,
//   1회성/반복 설정)". 배너 관리(aa0fad2)에서 확립된 CMS 단순 CRUD 패턴을
//   그대로 재사용한다. 배너와의 핵심 차이점:
//   - image_file_id/link_url이 04A 명시상 nullable(배너는 image_file_id NN)
//     → 텍스트 전용 팝업(공지성) 허용을 위해 imageUrl을 optional로 설계.
//   - display_condition(JSONB) — 04A가 배너에서는 명시적으로 배제했던
//     필드이나 팝업에는 명시되어 있음. SQLite JSONB 미지원이므로
//     SubscriptionPlan.benefits와 동일한 전례(String + JSON.stringify/parse)
//     를 적용한다. "1회성/반복 설정"은 05 화면기능 문구이며 04A 컬럼으로는
//     display_condition JSON 내부에 {once: boolean, segment?: string} 형태로
//     담아 표현한다(04A 컬럼 추가 없이 05 요구사항을 JSON 필드 내부 스키마로
//     수용 — 원칙② 설계충돌 방지, 컬럼 신설 대신 기존 JSONB 컬럼 활용).
// [start_at/end_at NN] 04A 명시: 배너와 달리 팝업은 두 컬럼 모두 NOT NULL
//   (노출기간이 필수). is_active 컬럼은 04A에 없으나 배너 전례와 동일하게
//   운영 편의를 위해 추가(soft delete와 별개의 노출 on/off 토글 용도).
model Popup {
  id               Int       @id @default(autoincrement())
  title            String
  imageUrl         String?   @map("image_url")
  linkUrl          String?   @map("link_url")
  displayCondition String?   @map("display_condition") // JSONB→String 매핑: {once, segment 등}
  startAt          DateTime  @map("start_at")
  endAt            DateTime  @map("end_at")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  createdBy        String?   @map("created_by")
  updatedBy        String?   @map("updated_by")

  @@index([startAt, endAt])
  @@map("popups")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.8 "CMS" — 3차 소단위: 공지사항 관리 (notices)
// ══════════════════════════════════════════════════════════════════

// ── 04A N-9: notices (※Base 포함) ───────────────────────────────────
// [범위 결정] 05§3.8 화면 스펙: "공지사항 관리 | notices CRUD(고정 여부)".
//   banners/popups(aa0fad2, a407d56)에서 확립된 CMS 단순 CRUD 패턴을 그대로
//   재사용한다. 04A 명시 컬럼은 title(NN)/content(TEXT, NN)/is_pinned(NN,
//   default false, IDX(is_pinned,created_at))뿐이며 노출기간/이미지 등의
//   컬럼이 없다 — 배너/팝업과 달리 "고정 여부"만으로 단순하게 구성된 스펙이므로
//   불필요한 컬럼을 임의로 추가하지 않는다(원칙② 설계충돌 방지).
model Notice {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  isPinned  Boolean   @default(false) @map("is_pinned")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  @@index([isPinned, createdAt])
  @@map("notices")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.8 "CMS" — 4차 소단위: FAQ 관리 (faqs)
// ══════════════════════════════════════════════════════════════════

// ── 04A N-10: faqs (※Base 포함) ─────────────────────────────────────
// [범위 결정] 05§3.8 화면 스펙: "FAQ 관리 | faqs CRUD(카테고리/정렬순서)".
//   notices(4f71ca7)와 동일한 CMS 단순 CRUD 패턴을 재사용한다. 04A 명시
//   컬럼은 category(NN,IDX)/question(NN)/answer(TEXT,NN)/sort_order(NN,
//   default 0)뿐이다.
model Faq {
  id        Int       @id @default(autoincrement())
  category  String
  question  String
  answer    String
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  @@index([category])
  @@map("faqs")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.8 "CMS" — 5차(마지막) 소단위: 이벤트 관리 (events, event_participations)
// ══════════════════════════════════════════════════════════════════

// ── 04A N-5: events (※Base 포함) ────────────────────────────────────
// [범위 결정] 05§3.8 화면 스펙: "이벤트 관리 | events, event_participations
//   CRUD 및 참여 현황 조회(룰렛/출석보너스 등 이벤트 타입별 설정 폼)".
//   banner_file_id(FK→files.id, nullable)는 배너 관리(aa0fad2)에서 확립된
//   전례와 동일하게 imageUrl(String, nullable)로 단순화한다(파일 업로드
//   서브시스템이 없는 현재 CMS 구현 범위에서 URL 직접입력 방식 일관 적용
//   — 원칙② 설계충돌 방지, 파일 업로드 인프라를 임의로 신설하지 않음).
//   config(JSONB, NN)는 SQLite String 매핑(SubscriptionPlan.benefits와
//   동일 전례) — event_type별 상이한 스키마를 자유롭게 담기 위한 용도이므로
//   JSON.stringify/parse로 애플리케이션 레벨 처리.
model Event {
  id        Int       @id @default(autoincrement())
  title     String
  imageUrl  String?   @map("image_url")
  eventType String    @map("event_type") // attendance_bonus / roulette / special_mission
  config    String    @map("config") // JSONB→String 매핑: 타입별 설정(플러그인 구조)
  startAt   DateTime  @map("start_at")
  endAt     DateTime  @map("end_at")
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  participations EventParticipation[]

  @@index([startAt, endAt])
  @@map("events")
}

// ── 04A N-6: event_participations (※Base 포함, UQ(event_id,user_id)) ─
// [범위 결정] event_id/user_id는 04A 명시 그대로 실제 FK(→events.id,
//   →users.id)로 구성한다(배너/팝업 등과 달리 이 테이블은 관계형 무결성이
//   핵심이므로 files FK 단순화 전례와는 별개로 원안 그대로 유지).
//   participation_data(JSONB, nullable)도 String 매핑, reward_claimed는
//   04A 명시 그대로 NN default false.
model EventParticipation {
  id                Int       @id @default(autoincrement())
  eventId           Int       @map("event_id")
  userId            Int       @map("user_id")
  participationData String?   @map("participation_data") // JSONB→String 매핑
  rewardClaimed     Boolean   @default(false) @map("reward_claimed")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@unique([eventId, userId])
  @@map("event_participations")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.9 "알림 관리" — 1차 소단위: 알림 템플릿 관리 (notification_templates)
// ══════════════════════════════════════════════════════════════════

// ── 04A N-1: notification_templates (※Base 포함) ───────────────────
// [범위 결정] 05§3.9 화면 스펙: "알림 템플릿 관리 | notification_templates
//   CRUD(푸시/인앱 공용 템플릿)". 04A 명시 컬럼은 code(NN,UQ)/title(NN,
//   VARCHAR100)/body(NN,VARCHAR500)/deep_link(Y)뿐이다. notices/faqs와
//   동일한 CMS류 단순 CRUD 패턴을 재사용한다(원칙② 설계충돌 방지).
model NotificationTemplate {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  title     String
  body      String
  deepLink  String?   @map("deep_link")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  notifications Notification[]

  @@map("notification_templates")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.9 "알림 관리" — 2차 소단위: 발송 이력 조회 (notifications)
// ══════════════════════════════════════════════════════════════════

// ── 04A N-2: notifications (※Base 포함, 파티션 대상) ────────────────
// [범위 결정] 05§3.9 화면 스펙: "발송 이력 조회 | notifications 조회
//   (수신자/발송상태)". 04A에는 별도 status enum 컬럼이 없고 is_read(읽음
//   여부)/sent_at(발송시각)만 존재하므로, "발송상태"는 is_read로 표현한다
//   (원칙② 설계충돌 방지: 04A에 없는 컬럼을 임의로 추가하지 않음). 이 화면은
//   조회 전용(관리자가 알림을 생성/수정/삭제하지 않음 — 실제 발송은 세그먼트
//   발송 화면(3차 소단위)에서 별도 처리)이므로 CUD Server Action을 두지 않는다.
//   title/body는 04A 명시대로 "발송 시점 스냅샷"이라 템플릿 변경과 무관하게
//   불변 — 템플릿 FK(template_id)는 참조용으로만 유지.
model Notification {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  templateId Int?      @map("template_id")
  title      String
  body       String
  isRead     Boolean   @default(false) @map("is_read")
  sentAt     DateTime  @default(now()) @map("sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")

  user     User                  @relation(fields: [userId], references: [id])
  template NotificationTemplate? @relation(fields: [templateId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.9 "알림 관리" — 4차(마지막) 소단위: 발송 설정 현황
//   (notification_preferences 집계, push_tokens 유효성 모니터링)
// ══════════════════════════════════════════════════════════════════

// ── 04A N-3: notification_preferences (※Base 포함, UQ(user_id,category)) ──
// [범위 결정] 05§3.9 화면 스펙: "발송 설정 현황 | notification_preferences
//   (회원별 수신동의) 집계, push_tokens 유효성 모니터링" — "집계"/"모니터링"만
//   명시(CUD 없음). 회원 앱에서 본인이 직접 설정하는 값이므로 관리자는 조회만
//   한다(원칙② 준수 — 04A에 관리자 CUD 스펙 없음).
model NotificationPreference {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  category  String // marketing/fortune_update/matching/community (04A 명시 화이트리스트)
  isEnabled Boolean   @default(true) @map("is_enabled")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, category])
  @@map("notification_preferences")
}

// ── 04A N-4: push_tokens (※Base 포함, UQ(fcm_token)) ────────────────
// [범위 결정] FCM 토큰은 회원 앱이 등록/갱신하는 값이며, 관리자는 플랫폼별
//   분포/유효성만 모니터링한다(조회 전용, 원칙② 준수).
model PushToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  fcmToken  String    @unique @map("fcm_token")
  platform  String // android/ios/web (04A 명시 화이트리스트)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("push_tokens")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.11 "시스템 설정" — 1차 소단위: 전역 설정값 관리 (system_settings)
// ══════════════════════════════════════════════════════════════════

// ── 04A O-1: system_settings (※Base 포함, UQ(key)) ──────────────────
// [범위 결정] 05§3.11 화면 스펙: "전역 설정값 관리 | system_settings(key-value)
//   CRUD — 예: 서비스 점검모드 on/off, 최소 앱버전". notices/point-policies에서
//   확립된 단순 CRUD 패턴을 재사용한다. value는 04A상 JSONB → SQLite에서는
//   String(JSON 문자열)으로 매핑(다른 JSONB 컬럼들과 동일 전례).
model SystemSetting {
  id          Int       @id @default(autoincrement())
  key         String    @unique
  value       String // JSON 문자열(불린/문자열/숫자/객체 모두 JSON.stringify로 저장)
  description String?
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  createdBy   String?   @map("created_by")
  updatedBy   String?   @map("updated_by")

  @@map("system_settings")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.11 "시스템 설정" — 2차 소단위: 접근/에러 로그 조회
// (access_logs, error_logs — 04A상 관리자 CUD 스펙 없음, 조회 전용)
// ══════════════════════════════════════════════════════════════════

// ── 04A O-3: access_logs (Append-only, 파티션 대상, 단기보관) ───────
// [범위 결정] 05§3.11 화면 스펙: "접근/에러 로그 조회 | access_logs, error_logs
//   조회(critical 필터)" — 조회만 명시(CUD 없음). admin_login_logs와 동일하게
//   Append-only 특성상 updated_at/updated_by/deleted_at 컬럼 생략(04A 0장 예외 규정).
model AccessLog {
  id             Int      @id @default(autoincrement())
  userId         Int?     @map("user_id")
  ipAddress      String   @map("ip_address")
  path           String
  method         String
  responseStatus Int      @map("response_status")
  latencyMs      Int?     @map("latency_ms")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("access_logs")
}

// ── 04A O-4: error_logs (Append-only) ────────────────────────────────
model ErrorLog {
  id            Int      @id @default(autoincrement())
  source        String // api/batch/ai
  errorCode     String?  @map("error_code")
  message       String
  stackTraceRef String?  @map("stack_trace_ref")
  severity      String // info/warning/critical
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([source, severity, createdAt])
  @@map("error_logs")
}

// ══════════════════════════════════════════════════════════════════
// 05§3.11 "시스템 설정" — 3차(마지막) 소단위: 통계 스냅샷 관리
// (statistics_snapshots — 배치 실행 상태 확인, 04A상 관리자 CUD 스펙 없음)
// ══════════════════════════════════════════════════════════════════

// ── 04A O-5: statistics_snapshots (※Base 포함, UQ(metric_code,period)) ──
// [범위 결정] 05§3.11 화면 스펙: "통계 스냅샷 관리 | statistics_snapshots 배치
//   실행 상태 확인" — "확인"만 명시(CUD 없음). 배치 시스템이 생성하는 값이므로
//   관리자는 조회만 한다(원칙② 준수 — 04A에 관리자 CUD 스펙 없음).
model StatisticsSnapshot {
  id         Int       @id @default(autoincrement())
  metricCode String    @map("metric_code") // 예: dau/point_issued_daily
  period     String // 예: 2026-07-23
  value      String // JSONB→String 매핑(집계 결과 JSON)
  status     String    @default("active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")
  createdBy  String?   @map("created_by")
  updatedBy  String?   @map("updated_by")

  @@unique([metricCode, period])
  @@map("statistics_snapshots")
}

// ══════════════════════════════════════════════════════════════════
// [신규] 알림패스(AlarmPass) — Fortune Fusion 3대 재화 중 ①시간제 콘텐츠
// 열람권. point_policies(key-value)와 달리 완전 CRUD 대상 정책 테이블로
// 설계(문서8 DB스키마초안 승인 반영). passType: ad/partner/subscription/event,
// durationMin: 60/180/1440(1h/3h/24h).
// ══════════════════════════════════════════════════════════════════

// ── 신규: pass_policies (관리자 CRUD, RBAC menuCode="reward" 재사용) ──
model PassPolicy {
  id             Int       @id @default(autoincrement())
  name           String
  passType       String    @map("pass_type") // ad/partner/subscription/event
  durationMin    Int       @map("duration_min") // 60/180/1440
  dailyLimit     Int?      @map("daily_limit") // 1일 최대 발급 횟수(null=무제한)
  ctaText        String?   @map("cta_text") // 홈 화면 CTA 버튼 문구
  bannerImageUrl String?   @map("banner_image_url")
  linkUrl        String?   @map("link_url") // 광고/파트너 랜딩 URL
  bonusPoint     Int       @default(0) @map("bonus_point") // 지급 시 함께 적립되는 복주머니 포인트
  isActive       Boolean   @default(true) @map("is_active")
  status         String    @default("active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  createdBy      String?   @map("created_by")
  updatedBy      String?   @map("updated_by")

  // ── [열림패스/행복머니/복주머니 통합정책] 확장 필드 ──
  // description: 정책 상세 설명(관리자/앱 노출용, ctaText와 별개)
  // scope: 이 패스가 적용되는 FeatureScope 키를 콤마(,)로 구분해 저장(SQLite는 스칼라 배열 미지원)
  //   예: "fortune_today,fortune_tarot,fortune_saju,fortune_compatibility,fortune_face_palm,fortune_theme"
  // happyMoneyPrice: 행복머니로 직접 구매 시 가격(null=행복머니 구매 불가 정책)
  // adRewardEnabled: 광고 시청 보상 경로로 지급 가능한지 여부
  // isFeatured/displayPriority: 앱 노출 우선순위 제어
  // uiCopy: 배너/프로모션 문구 등 JSON 문자열(ctaText는 단일 버튼 문구, uiCopy는 확장 카피)
  description          String?
  scope                String  @default("fortune_today,fortune_tarot,fortune_saju,fortune_compatibility,fortune_face_palm,fortune_theme") @map("scope")
  happyMoneyPrice      Int?    @map("happy_money_price")
  adRewardEnabled      Boolean @default(true) @map("ad_reward_enabled")
  isFeatured           Boolean @default(false) @map("is_featured")
  // ── [열림패스 첨부파일/광고소스 연동] §8-1 대표 첨부파일 3종(soft reference, FK 미설정) ──
  // heroAttachmentId: 상품 카드/상세의 대표 배너 / promoAttachmentId: 광고시청 유도 배너
  // fallbackAttachmentId: 이 상품에 연결된 모든 광고소스가 실패/no-fill일 때 공통 대체 소재
  // (개별 광고소스에도 fallbackAttachmentId가 있어 광고소스 우선, 없으면 상품 fallback 사용)
  heroAttachmentId     Int?    @map("hero_attachment_id")
  promoAttachmentId    Int?    @map("promo_attachment_id")
  fallbackAttachmentId Int?    @map("fallback_attachment_id")
  displayPriority      Int     @default(0) @map("display_priority")
  uiCopy               String? @map("ui_copy")

  // ── [프리패스 테스트 인프라] §3 운영기간/테스트모드 필드 ──
  // startAt/endAt: 노출/판매 유효기간(null=상시). testModeAllowed: 테스트랩에서 이 정책을
  // 대상으로 시뮬레이션(강제지급/강제만료 등)을 실행할 수 있는지 여부(false면 운영중 정책 보호).
  startAt         DateTime? @map("start_at")
  endAt           DateTime? @map("end_at")
  testModeAllowed Boolean   @default(true) @map("test_mode_allowed")

  // ── [프리패스 단순화 - 쿠팡파트너스 전용] §1 광고 확인 대기시간(초) ──
  // 사용자가 "쿠팡 방문하기"를 누르고 앱으로 돌아온 뒤, 자동 지급 전 대기하는 초.
  // 관리자는 4/5/10초 중에서만 선택(드롭다운). 광고 이미지/링크 자체는 더 이상 이
  // 테이블에 직접 두지 않고 Banner(positionCode='open_pass')를 단일 소스로 사용한다.
  adWaitSeconds Int @default(5) @map("ad_wait_seconds")

  // ── [프리패스 UI 문구 관리자 연동] 바텀시트 "?" 도움말 팝업 및 아이콘 바로
  // 아래 안내 제목/문구를 관리자가 직접 입력해 앱/웹에 실시간 반영한다.
  // adHelpMessage: "?" 아이콘 탭 시 뜨는 안내 팝업 본문.
  // adGuideTitle : 팝업 아이콘 바로 아래 표시되는 안내 제목(굵은 글씨).
  // adGuideText  : 안내 제목 바로 아래 표시되는 부연 설명 문구.
  adHelpMessage String? @map("ad_help_message")
  adGuideTitle  String? @map("ad_guide_title")
  adGuideText   String? @map("ad_guide_text")

  // ── [신통방통 기존시스템유지+프리패스 카테고리별 이용횟수 제한] §7
  // categoryMaxUsage: 이 정책으로 발급된 패스 1건(활성 기간) 동안, 동일 카테고리
  // (fortune_categories.category_key 기준, 예: daily/saju/face/palm)를 최대 몇 번
  // 이용할 수 있는지(기본 2회). null이면 무제한(레거시 정책 호환용, 신규 기본값은 2).
  categoryMaxUsage Int? @default(2) @map("category_max_usage")

  userPasses         UserPass[]
  attachmentBindings OpenPassProductAttachment[]
  adSourceBindings   OpenPassProductAdSource[]

  @@map("pass_policies")
}

// ── 신규: user_passes (Append-only 성격, 사용자별 발급/소진 이력) ──
// [통합정책 확장] status/revokedAt/scope/grantedByAdminId 추가:
//   - status: active/expired/revoked (강제만료·회수를 만료와 구분해 리포팅 가능하게)
//   - scope: 정책의 scope를 오버라이드하는 특정 scope만 부여할 때 사용(null=정책 scope 그대로 적용)
//   - grantedByAdminId: 관리자 수동지급/테스트랩 지급 시 감사 추적용(광고/구매 등 일반 발급은 null)
model UserPass {
  id               Int       @id @default(autoincrement())
  userId           Int       @map("user_id")
  policyId         Int       @map("policy_id")
  activatedAt      DateTime  @default(now()) @map("activated_at")
  expiresAt        DateTime  @map("expires_at")
  sourceType       String    @map("source_type") // ad/partner/subscription/event/manual/test_mode
  status           String    @default("active") // active/expired/revoked
  revokedAt        DateTime? @map("revoked_at")
  scope            String?   @map("scope")
  grantedByAdminId Int?      @map("granted_by_admin_id")
  createdAt        DateTime  @default(now()) @map("created_at")

  user   User       @relation(fields: [userId], references: [id])
  policy PassPolicy @relation(fields: [policyId], references: [id])

  categoryUsages PassCategoryUsage[]

  @@index([userId, expiresAt])
  @@map("user_passes")
}

// ── [신통방통 기존시스템유지+프리패스 카테고리별 이용횟수 제한] §7 신규 테이블 ──
// 목적: "동일 카테고리(오늘의 운세/사주/관상/손금 등) 최대 N회(기본 2회)" 제한을
// 활성 프리패스(UserPass) 1건 단위로 추적한다. userPassId 기준으로 묶는 이유:
// 패스가 만료되고 새로 발급되면(예: 다시 60분 프리패스 획득) 이전 패스의 이용
// 카운트와 완전히 분리되어 자동으로 0부터 다시 시작되어야 하기 때문이다(패스
// 재발급마다 리셋). userId를 별도 컬럼으로도 보관해 관리자 화면에서 조인 없이
// 회원별 조회를 쉽게 한다(운영상 편의, 정합성은 userPassId가 원본).
model PassCategoryUsage {
  id          Int      @id @default(autoincrement())
  userPassId  Int      @map("user_pass_id")
  userId      Int      @map("user_id")
  categoryKey String   @map("category_key") // fortune_categories.category_key (daily/saju/face/palm 등)
  usageCount  Int      @default(0) @map("usage_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userPass UserPass @relation(fields: [userPassId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([userPassId, categoryKey])
  @@index([userId, categoryKey])
  @@map("pass_category_usages")
}

// ══════════════════════════════════════════════════════════════════
// [열림패스/복주머니 통합정책 — Part D]
//
// [재화 구조 정리, 2026-08] 아래 설계는 원래 "행복머니/복주머니"를
// Wallet(POINT) vs LuckPouchWallet의 서로 다른 두 테이블로 분리하는 "3대 자산"
// 구조로 설계되었으나, 최종 정책은 "프리패스(시간권) + 복주머니(유일 화폐)"
// 2자산 구조로 정리되어, LuckPouchWallet/LuckPouchHistory는 실제 앱의 어느
// 화면도 읽지 않는 죽은 테이블임을 코드 전수 조사로 확인했다. 스키마 차원의
// 완전 제거(DROP TABLE)를 시도했으나 이 프로젝트의 마이그레이션 이력 drift로
// 인해 전체 DB 리셋이 요구되어 보류했다(모델 정의 자체는 아래에 그대로 남아
// 있음 — 상세 사유는 두 모델 바로 위 주석 참고). 런타임 코드에서는 이미 완전히
// 분리되어 있어(대체: earnLuckPouch/spendLuckPouch 공용 엔진이
// Wallet(currencyType="POINT") 하나만을 복주머니 원장으로 다룬다) 데이터
// 정확성 문제는 없고, 순수 스키마 정리 부채로만 존재한다.
// HappyMoneyProduct(행복머니 충전 카탈로그)는
// RewardSubNav.tsx에 이미 [금지]로 문서화된 레거시 잔존물로, 실제 앱이 호출하지
// 않는다(별도 범위의 스키마 정리 대상으로 남겨둔).
//
// 자산 원장 설계 원칙(현재):
//  - 복주머니(luck_pouch) = Wallet(currencyType="POINT") + PointHistory 유일 테이블
//    (적립/사용/구매 모두 이 하나의 원장을 공유한다 — 이원화 금지 원칙)
//  - 프리패스(open_pass) = UserPass/PassPolicy(시간기반 접근권, 화폐 개념 없음)
//  - AssetTransaction(통합 원장)은 신규 테이블을 따로 만들지 않고,
//    PointHistory + UserPass 2개 원장을 조회 시점에 AdminSimulationService가
//    통합 뷰로 합쳐 제공한다(스키마 중복/불일치 위험 회피).
//  - AdminAuditLog는 기존 OperationLog를 그대로 재사용한다(targetType으로 구분).
// ══════════════════════════════════════════════════════════════════

// ── 행복머니 충전 상품 정책 ──
model HappyMoneyProduct {
  id                 Int       @id @default(autoincrement())
  name               String
  cashPrice          Int       @map("cash_price") // 원화 가격(KRW)
  happyMoneyAmount   Int       @map("happy_money_amount") // 지급 행복머니 수량
  bonusAmount        Int       @default(0) @map("bonus_amount") // 추가 보너스 수량
  isActive           Boolean   @default(true) @map("is_active")
  isFeatured         Boolean   @default(false) @map("is_featured")
  displayPriority    Int       @default(0) @map("display_priority")
  allowedUsageScopes String    @default("pass,subscription,gift") @map("allowed_usage_scopes") // 콤마구분: pass/subscription/gift/all
  isEventGrantable   Boolean   @default(true) @map("is_event_grantable") // 이벤트로 지급 가능한지
  isManualGrantable  Boolean   @default(true) @map("is_manual_grantable") // 관리자 수동 지급 가능한지
  status             String    @default("active")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  createdBy          String?   @map("created_by")
  updatedBy          String?   @map("updated_by")

  @@map("happy_money_products")
}

// ── 복주머니 적립/소비/구매 규칙 ──
model LuckPouchRule {
  id                Int       @id @default(autoincrement())
  name              String
  ruleType          String    @map("rule_type") // earn/spend/purchase
  actionType        String    @map("action_type") // attendance/cheer/empathize/highlight/expose_boost/talisman_make/wish_room_ritual/wish_room_wish/event/manual/purchase 등
  targetScope       String?   @map("target_scope") // community/wish_board/wish_room/talisman(null=범용)
  amount            Int // earn/spend: 적립·차감량 / purchase: 지급 복주머니 수량
  cashPrice         Int?      @map("cash_price") // ruleType=purchase일 때 원화 가격(그 외 null)
  dailyLimit        Int?      @map("daily_limit")
  isPurchasable     Boolean   @default(false) @map("is_purchasable") // ruleType=purchase 항목 노출 여부
  isManualGrantable Boolean   @default(true) @map("is_manual_grantable")
  isActive          Boolean   @default(true) @map("is_active")
  displayPriority   Int       @default(0) @map("display_priority")
  status            String    @default("active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  createdBy         String?   @map("created_by")
  updatedBy         String?   @map("updated_by")

  @@map("luck_pouch_rules")
}

// [재화 구조 정리, 2026-08] 아래 두 모델(LuckPouchWallet/LuckPouchHistory)은 실제
// 앱의 어느 화면·API도 읽지 않는 죽은 테이블임을 코드 전수 조사로 확인했다(모든
// 실제 복주머니 잔액/원장 조작은 Wallet(currencyType="POINT") + PointHistory와
// 공용 엔진 earnLuckPouch/spendLuckPouch(src/lib/luck-pouch-engine.ts)만 사용).
// 스키마에서 완전히 제거(DROP TABLE)하는 것을 시도했으나, 이 프로젝트의 41개
// 마이그레이션 이력이 schema.prisma의 현재 상태와 이미 광범위하게 어긋나 있어
// (luck_pouch 무관 다수 테이블 — wish_config/wish_reviews/banners/wishes 등 —
// 에 걸친 drift) `prisma migrate dev`가 "SQLite 개발 DB 전체 리셋 필요(모든 데이터
// 유실)"를 요구했다. 이 두 죽은 테이블을 지우자고 운영 중인 개발 DB의 유저/지갑/
// 소원 등 전체 데이터를 날릴 수는 없으므로, 스키마 차원 제거는 보류하고 모델
// 정의는 그대로 유지한다(런타임 코드에서 이미 완전히 분리되어 있어 데이터 정확성
// 문제는 없음 — 순수 스키마 정리 부채로만 존재). 마이그레이션 이력 정리는 이번
// "재화 구조 재연결" 범위를 벗어나는 별도의 더 큰 작업으로 남겨둔다.

// ── 복주머니 잔액(죽은 테이블 — 위 주석 참고, 실제로는 미사용) ──
model LuckPouchWallet {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique @map("user_id")
  balance         Int       @default(0)
  balanceSyncedAt DateTime? @map("balance_synced_at")
  status          String    @default("active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user      User               @relation(fields: [userId], references: [id])
  histories LuckPouchHistory[]

  @@map("luck_pouch_wallets")
}

// ── 복주머니 원장(죽은 테이블 — 위 주석 참고, 실제로는 미사용) ──
model LuckPouchHistory {
  id           Int      @id @default(autoincrement())
  walletId     Int      @map("wallet_id")
  userId       Int      @map("user_id")
  amount       Int // +적립/-차감
  type         String // earn/spend/grant/revoke/purchase
  sourceType   String   @map("source_type") // attendance/cheer/empathize/highlight/expose_boost/talisman_make/wish_room_ritual/admin_adjust/purchase/test_mode 등
  sourceId     Int?     @map("source_id")
  balanceAfter Int      @map("balance_after")
  memo         String?
  createdAt    DateTime @default(now()) @map("created_at")

  wallet LuckPouchWallet @relation(fields: [walletId], references: [id])
  user   User            @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([sourceType, sourceId])
  @@map("luck_pouch_histories")
}

// ── 기능-자산 매핑(FeatureAssetBinding) — 화면별 하드코딩 금지의 핵심 테이블 ──
// scope는 Flutter FeatureScope 확장 키와 1:1 대응(fortune_today/wish_room/community/talisman 등)
model FeatureAssetBinding {
  id              Int      @id @default(autoincrement())
  scope           String   @unique // fortune_today/fortune_tarot/.../wish_board/wish_room/talisman/community/ai_consulting/subscription/gift_shop
  featureGroup    String   @map("feature_group") // fortune/community/premium_shop
  primaryAsset    String   @map("primary_asset") // open_pass/happy_money/luck_pouch/free
  secondaryAssets String?  @map("secondary_assets") // 콤마구분 보조 자산 목록
  accessType      String   @map("access_type") // free/open_pass/happy_money/luck_pouch/mixed_limited
  editableByAdmin Boolean  @default(true) @map("editable_by_admin")
  isActive        Boolean  @default(true) @map("is_active")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  updatedBy       String?  @map("updated_by")

  @@map("feature_asset_bindings")
}

// ══════════════════════════════════════════════════════════════════
// [신규] 열림패스 첨부파일/광고소스 관리 — §1~17 요구사항 반영
// "단순 파일 업로드"가 아니라 "용도(purpose)"를 함께 저장하고,
// 열림패스 상품(PassPolicy)과 N:M으로 연결 가능한 재사용 가능 자산으로 설계한다.
// ══════════════════════════════════════════════════════════════════

// ── 열림패스 첨부파일(이미지/영상/문서/외부링크) — 상품과 독립된 재사용 가능 엔티티 ──
model OpenPassAttachment {
  id           Int       @id @default(autoincrement())
  fileName     String    @map("file_name") // 원본 파일명(또는 external_link일 때 표시용 제목)
  fileType     String    @map("file_type") // image/video/document/external_link/rich_text_html/ad_fallback_image/ad_fallback_video
  mimeType     String?   @map("mime_type")
  // fileType=rich_text_html일 때는 URL이 없을 수 있어 nullable(htmlContent로 대체 표시).
  fileUrl      String?   @map("file_url") // 업로드된 정적 파일 URL 또는 외부 링크 URL
  thumbnailUrl String?   @map("thumbnail_url") // image는 fileUrl과 동일, video/document는 별도 썸네일(선택)
  purpose      String    @map("purpose") // hero_banner/product_thumbnail/reward_ad_promo/fallback_creative/terms_doc/event_banner/modal_image 등
  fileSize     Int?      @map("file_size") // bytes
  htmlContent  String?   @map("html_content") // fileType=rich_text_html일 때 본문
  isActive     Boolean   @default(true) @map("is_active")
  displayOrder Int       @default(0) @map("display_order")
  metadataJson String?   @map("metadata_json") // 자유 형식 부가 정보(JSON 문자열)
  status       String    @default("active") // active/deleted
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")

  productBindings OpenPassProductAttachment[]

  @@index([purpose, isActive])
  @@map("open_pass_attachments")
}

// ── 열림패스 광고소스(리워드 광고 지급 채널) — 상품과 독립된 재사용 가능 엔티티 ──
model OpenPassAdSource {
  id                   Int       @id @default(autoincrement())
  sourceName           String    @map("source_name")
  sourceType           String    @map("source_type") // admob_rewarded/admob_interstitial/applovin_rewarded/meta_audience_rewarded/custom_vast/custom_web_ad/internal_promo_ad
  networkName          String?   @map("network_name")
  adUnitId             String?   @map("ad_unit_id")
  placementId          String?   @map("placement_id")
  rewardType           String?   @map("reward_type") // open_pass_minutes 등
  rewardValue          Int?      @map("reward_value")
  cooldownSeconds      Int       @default(0) @map("cooldown_seconds")
  dailyLimit           Int?      @map("daily_limit")
  failoverEnabled      Boolean   @default(true) @map("failover_enabled")
  // soft reference(FK 미설정) — OpenPassAttachment.id. 삭제 시 참조 무결성은 애플리케이션에서 체크.
  fallbackAttachmentId Int?      @map("fallback_attachment_id")
  testModeEnabled      Boolean   @default(false) @map("test_mode_enabled")
  isActive             Boolean   @default(true) @map("is_active")
  priority             Int       @default(0) @map("priority")
  startAt              DateTime? @map("start_at")
  endAt                DateTime? @map("end_at")
  status               String    @default("active") // active/deleted
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")
  createdBy            String?   @map("created_by")
  updatedBy            String?   @map("updated_by")

  // ── [프리패스 테스트 인프라] §4 테스트 광고소스(mock_rewarded_*) 전용 필드 ──
  // simulatedDurationSeconds: 테스트 광고 화면에서 진행바/타이머로 보여줄 가짜 시청 시간(초).
  // failMode: mock_rewarded_fail 타입일 때 실패 사유 라벨(예: "network_error","policy_violation").
  // 실광고 소스에는 사용하지 않음(둘 다 null 유지).
  simulatedDurationSeconds Int?    @map("simulated_duration_seconds")
  failMode                 String? @map("fail_mode")

  productBindings OpenPassProductAdSource[]
  rewardLogs      OpenPassAdRewardLog[]

  @@index([sourceType, isActive])
  @@map("open_pass_ad_sources")
}

// ── 상품(PassPolicy) - 첨부파일(OpenPassAttachment) N:M 바인딩 ──
// usageType: 상품 화면 내 실제 노출 위치(hero_banner/pre_ad_banner/post_ad_banner/detail_gallery/fallback 등).
// attachment.purpose(파일 등록 시의 용도)와 별개로, "이 상품에서는 이 위치에 쓴다"를 여기서 결정한다.
model OpenPassProductAttachment {
  id           Int      @id @default(autoincrement())
  passPolicyId Int      @map("pass_policy_id")
  attachmentId Int      @map("attachment_id")
  usageType    String   @map("usage_type") // hero_banner/pre_ad_banner/post_ad_banner/detail_gallery/fallback/modal_image 등
  displayOrder Int      @default(0) @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  passPolicy PassPolicy         @relation(fields: [passPolicyId], references: [id])
  attachment OpenPassAttachment @relation(fields: [attachmentId], references: [id])

  @@unique([passPolicyId, attachmentId, usageType])
  @@index([passPolicyId, usageType])
  @@map("open_pass_product_attachments")
}

// ── 상품(PassPolicy) - 광고소스(OpenPassAdSource) N:M 바인딩 ──
// platform: all/android/ios/web — 플랫폼별 광고소스 분리 구조 준비(§6-4 요구사항).
model OpenPassProductAdSource {
  id           Int      @id @default(autoincrement())
  passPolicyId Int      @map("pass_policy_id")
  adSourceId   Int      @map("ad_source_id")
  priority     Int      @default(0) @map("priority") // 낮을수록 우선(failover 순서)
  isPrimary    Boolean  @default(false) @map("is_primary")
  platform     String   @default("all") @map("platform") // all/android/ios/web
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  passPolicy PassPolicy       @relation(fields: [passPolicyId], references: [id])
  adSource   OpenPassAdSource @relation(fields: [adSourceId], references: [id])

  @@unique([passPolicyId, adSourceId, platform])
  @@index([passPolicyId, platform, priority])
  @@map("open_pass_product_ad_sources")
}

// ── 광고 시청/보상 이력 — cooldown/dailyLimit 체크 + 중복지급 방지(idempotencyKey)의 근거 원장 ──
model OpenPassAdRewardLog {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  adSourceId     Int      @map("ad_source_id")
  passPolicyId   Int?     @map("pass_policy_id")
  result         String   @map("result") // success/fail/no_fill
  rewardGranted  Boolean  @default(false) @map("reward_granted")
  userPassId     Int?     @map("user_pass_id") // 지급된 UserPass.id(성공 시)
  idempotencyKey String?  @unique @map("idempotency_key") // 클라이언트가 생성해 전달, 중복 reward-complete 방지
  createdAt      DateTime @default(now()) @map("created_at")

  user     User             @relation(fields: [userId], references: [id])
  adSource OpenPassAdSource @relation(fields: [adSourceId], references: [id])

  @@index([userId, adSourceId, createdAt])
  @@map("open_pass_ad_reward_logs")
}

// ══════════════════════════════════════════════════════════════════
// [Fortune Category Master 확장] 운세 카테고리 시스템 확장 작업
// (요청: "이미 구현된 운세/화면/결과/관리자 연결은 유지, 없는 카테고리와
//  부족한 관리자 연결만 추가")
//
// [설계 결정] AiPromptTemplate(버전 관리)는 이미 15개 도메인 전부에 대해
// 완전히 동작 중이므로 그대로 재사용한다. 여기서 새로 추가하는 두 모델은
// "앱 전체보기 화면에 노출하기 위한 카테고리 메타(제목/설명/아이콘/그룹/
// 정렬/노출/추천/라우트)"만 담당하며, fortuneTypeOrDomain(=categoryKey)로
// AiPromptTemplate과 1:1 매핑된다. 결과 텍스트의 실제 구조/톤/길이는
// 여전히 AiPromptTemplate.templateBody(LLM 시스템 프롬프트)가 통제한다.
// ══════════════════════════════════════════════════════════════════

// ── Fortune Category Group (전체보기 그룹 섹션: 오늘/사주/타로/궁합 등) ──
model FortuneCategoryGroup {
  id           Int       @id @default(autoincrement())
  code         String    @unique @map("code") // today/saju/tarot/compatibility/face_palm/name_theme/consultation
  label        String    @map("label")
  description  String?   @map("description")
  displayOrder Int       @default(0) @map("display_order")
  isVisible    Boolean   @default(true) @map("is_visible")
  status       String    @default("active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")
  createdBy    String?   @map("created_by")
  updatedBy    String?   @map("updated_by")

  categories FortuneCategory[]

  @@map("fortune_category_groups")
}

// ── Fortune Category Master (전체보기/결과보기 노출용 카테고리 메타) ──
model FortuneCategory {
  id                  Int       @id @default(autoincrement())
  categoryKey         String    @unique @map("category_key") // = AiPromptTemplate.fortuneTypeOrDomain (saju/saju_wealth/.../name)
  slug                String    @unique @map("slug")
  title               String    @map("title")
  shortDescription    String?   @map("short_description")
  groupId             Int?      @map("group_id")
  icon                String?   @map("icon") // Material icon codepoint 이름(e.g. "auto_stories_outlined")
  heroImageUrl        String?   @map("hero_image_url")
  isActive            Boolean   @default(true) @map("is_active")
  isVisible           Boolean   @default(true) @map("is_visible")
  displayOrder        Int       @default(0) @map("display_order")
  isFeatured          Boolean   @default(false) @map("is_featured")
  badgeLabel          String?   @map("badge_label") // NEW/추천/대표 등 (없으면 배지 미노출)
  requiresPass        Boolean   @default(true) @map("requires_pass")
  route               String?   @map("route") // Flutter 라우트 경로 (없으면 "준비중")
  resultLengthHint    String?   @map("result_length_hint") // "400~500자" 등 관리자 안내용
  inputTemplateId     String?   @map("input_template_id")
  loadingTemplateId   String?   @map("loading_template_id")
  resultTemplateId    String?   @map("result_template_id")
  paywallTemplateId   String?   @map("paywall_template_id")
  relatedCategoryKeys String?   @map("related_category_keys") // JSON string array
  status              String    @default("active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")
  createdBy           String?   @map("created_by")
  updatedBy           String?   @map("updated_by")

  group FortuneCategoryGroup? @relation(fields: [groupId], references: [id])

  @@index([groupId, displayOrder])
  @@index([isActive, isVisible])
  @@map("fortune_categories")
}

// ════════════════════════════════════════════════════════════════
// [메인화면 관리자 편집기] Page > Section > Component Block > Content
// > Display Rule 계층 구조.
//
// [핵심 설계] "완전 자유 배치"가 아니라 "블록형 편집"이다 — PageSection의
// blockType은 Flutter가 미리 준비한 위젯(HomePageRenderer가 매핑)만 참조할
// 수 있고, 관리자는 그 블록 안의 title/subtitle/description/buttonText 등
// "내용"과 stylePreset 같은 "프리셋"만 바꾈 수 있다(폰트/패딩/좌표 직접
// 입력 금지 — 앱 코드 레벨에서 강제).
//
// [버전 관리 방식] draft → publish 시 새 PageVersion을 만들어 draft의
// PageSection들을 복제(snapshot)하고, PageConfig의 currentPublishedVersionId
// 포인터만 그 새 버전으로 옮긴다. 과거 published 버전의 PageSection 행은
// 삭제하지 않고 그대로 보관하므로, 롤백은 포인터를 옛 버전으로 되돌리는
// 것만으로 즉시 가능하다(복사/재생성 불필요, append-only 패턴).
// ════════════════════════════════════════════════════════════════

// ── PageConfig: 페이지별(현재는 "home" 1개) 발행/초안 버전 포인터 ──
model PageConfig {
  id                        Int      @id @default(autoincrement())
  pageKey                   String   @unique @map("page_key") // 현재는 "home"만 사용
  currentPublishedVersionId Int?     @map("current_published_version_id")
  currentDraftVersionId     Int?     @map("current_draft_version_id")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  currentPublishedVersion PageVersion? @relation("PageConfigPublished", fields: [currentPublishedVersionId], references: [id])
  currentDraftVersion     PageVersion? @relation("PageConfigDraft", fields: [currentDraftVersionId], references: [id])

  @@map("page_configs")
}

// ── PageVersion: pageKey별 버전 스냅샷(draft/published/archived) ──
model PageVersion {
  id            Int       @id @default(autoincrement())
  pageKey       String    @map("page_key")
  versionNumber Int       @map("version_number")
  status        String    @default("draft") @map("status") // draft/published/archived
  createdBy     String?   @map("created_by")
  publishedBy   String?   @map("published_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")

  sections         PageSection[]
  publishedForPage PageConfig[]  @relation("PageConfigPublished")
  draftForPage     PageConfig[]  @relation("PageConfigDraft")

  @@unique([pageKey, versionNumber])
  @@index([pageKey, status])
  @@map("page_versions")
}

// ── PageSection: 실제 섹션 콘텐츠(제목/부제/버튼/링크/프리셋/노출/스케줄) ──
model PageSection {
  id                 Int       @id @default(autoincrement())
  pageVersionId      Int       @map("page_version_id")
  sectionKey         String    @map("section_key") // 버전 간 동일 섹션 추적용 안정 식별자(예: "hero","daily_fortune")
  blockType          String    @map("block_type") // hero_banner/single_card/... (BLOCK_TYPES 화이트리스트)
  title              String?
  subtitle           String?
  description        String?
  buttonText         String?   @map("button_text")
  buttonLink         String?   @map("button_link")
  badgeText          String?   @map("badge_text")
  emptyStateText     String?   @map("empty_state_text")
  stylePreset        String    @default("default") @map("style_preset")
  backgroundPreset   String    @default("white") @map("background_preset")
  alignmentPreset    String    @default("left") @map("alignment_preset")
  densityPreset      String    @default("normal") @map("density_preset")
  isVisible          Boolean   @default(true) @map("is_visible")
  status             String    @default("visible") @map("status") // visible/hidden/archived
  isPinned           Boolean   @default(false) @map("is_pinned") // 고정 섹션(순서변경 최상단/최하단 등 안내용)
  isRequired         Boolean   @default(false) @map("is_required") // 필수 섹션(완전 삭제 방지, hidden까지만 허용)
  sortOrder          Int       @default(0) @map("sort_order")
  platformTargets    String?   @map("platform_targets") // JSON 배열 문자열(["ios","android","web"]), null=전체
  scheduleEnabled    Boolean   @default(false) @map("schedule_enabled")
  startAt            DateTime? @map("start_at")
  endAt              DateTime? @map("end_at")
  linkedAssetType    String?   @map("linked_asset_type") // open_pass/happy_money/luck_pouch
  linkedFeatureScope String?   @map("linked_feature_scope")
  linkedCampaignId   String?   @map("linked_campaign_id")
  linkedProductId    String?   @map("linked_product_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")
  createdBy          String?   @map("created_by")
  updatedBy          String?   @map("updated_by")

  pageVersion  PageVersion                @relation(fields: [pageVersionId], references: [id])
  attachments  SectionAttachmentBinding[]
  displayRules SectionDisplayRule[]

  @@index([pageVersionId, sortOrder])
  @@index([pageVersionId, sectionKey])
  @@map("page_sections")
}

// ── SectionAttachmentBinding: 섹션 배너/아이콘/배경/썸네일/fallback 이미지 ──
model SectionAttachmentBinding {
  id            Int      @id @default(autoincrement())
  sectionId     Int      @map("section_id")
  attachmentUrl String   @map("attachment_url")
  usageType     String   @map("usage_type") // banner/icon/background/thumbnail/fallback
  isPrimary     Boolean  @default(false) @map("is_primary")
  displayOrder  Int      @default(0) @map("display_order")
  createdAt     DateTime @default(now()) @map("created_at")

  section PageSection @relation(fields: [sectionId], references: [id])

  @@index([sectionId, usageType])
  @@map("section_attachment_bindings")
}

// ── SectionDisplayRule: 유저상태/플랫폼/기간에 따른 조건부 노출 규칙 ──
// [설계] 운영자가 이해하기 쉬운 (ruleType, ruleOperator, ruleValue) 3분할
// 구조만 제공한다 — 개발자용 표현식(JS 조건문 등) 직접 입력은 지원하지 않는다.
model SectionDisplayRule {
  id           Int      @id @default(autoincrement())
  sectionId    Int      @map("section_id")
  ruleType     String   @map("rule_type")
  // login_status/user_new/open_pass_status/happy_money_balance/
  // luck_pouch_status/daily_fortune_viewed/wish_board_participated/
  // event_period/platform 중 하나(RULE_TYPES 화이트리스트)
  ruleOperator String   @map("rule_operator") // equals/not_equals/gte/lte/in
  ruleValue    String   @map("rule_value") // 문자열(다중값은 JSON 배열 문자열)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  section PageSection @relation(fields: [sectionId], references: [id])

  @@index([sectionId])
  @@map("section_display_rules")
}

// ── PageAuditLog: 관리자 CUD 작업 감사 로그(변경 이력 화면 데이터 소스) ──
model PageAuditLog {
  id         Int      @id @default(autoincrement())
  adminId    String?  @map("admin_id")
  pageKey    String   @map("page_key")
  sectionId  Int?     @map("section_id")
  actionType String   @map("action_type") // create/update/reorder/hide/archive/duplicate/publish/rollback 등
  summary    String
  payload    String? // JSON 문자열(변경 전/후 스냅샷 등)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([pageKey, createdAt])
  @@map("page_audit_logs")
}

// ── IntroConfig: 앱 첫 진입 인트로(스플래시+온보딩 카드+시작화면) 관리자 설정 ──
// [인트로 전면 개편] 싱글턴 row(id=1 고정) 방식의 key-value에 가까운 설정 테이블.
// "자유 배치/좌표 편집/애니메이션 수치"는 제공하지 않고, 운영에 필요한 최소값
// (on/off, 문구, 이미지 URL, 보상 수량)만 관리자가 수정하도록 필드를 고정한다.
// 회원가입 보상 "수량"은 이 테이블이 아니라 PointPolicy(sourceType="signup_reward")가
// 단일 소스이며(리워드관리 화면에서 이미 편집 가능), 여기 signupRewardAmount 필드는
// 인트로 화면 문구에 "복주머니 N개 지급" 숫자를 표시하기 위한 캐시성 값이다.
// PointPolicy와 값이 어긋나지 않도록 관리자 폼 저장 시 두 값을 함께 갱신한다.
model IntroConfig {
  id                  Int     @id @default(1)
  isEnabled           Boolean @default(true) @map("is_enabled") // 인트로 on/off
  showOnlyFirstLaunch Boolean @default(true) @map("show_only_first_launch")
  showSkipButton      Boolean @default(true) @map("show_skip_button")
  showGuestHint       Boolean @default(true) @map("show_guest_hint") // "로그인 없이 둘러보기" 문구 on/off

  // 1단계: 브랜드 스플래시
  splashTitle    String  @default("신통방통") @map("splash_title")
  splashSubtitle String? @map("splash_subtitle") // 짧은 카피(선택, 비워두면 무카피)

  // 2단계: 카드1(프리패스)
  card1Title       String  @default("광고 한 번으로, 1시간 동안 자유롭게") @map("card1_title")
  card1Description String  @default("프리패스를 받으면 오늘의 운세, 타로 등 전체 운세 콘텐츠를 가볍게 볼 수 있어요.") @map("card1_description")
  card1ImageUrl    String? @map("card1_image_url")

  // 3단계: 카드2(복주머니)
  card2Title       String  @default("복주머니는 무료로 모으고, 자유롭게 써요") @map("card2_title")
  card2Description String  @default("광고를 보거나 활동하면 복주머니가 쌓이고, 소원게시판과 소원성에서 사용할 수 있어요.") @map("card2_description")
  card2ImageUrl    String? @map("card2_image_url")

  // 4단계: 시작 화면(CTA)
  ctaTitle           String @default("이제 신통방통을 시작해보세요") @map("cta_title")
  ctaSubtitle        String @default("먼저 둘러보고, 원할 때 가입해도 괜찮아요.") @map("cta_subtitle")
  signupRewardText   String @default("지금 가입하면 복주머니 100개 지급") @map("signup_reward_text")
  signupRewardAmount Int    @default(100) @map("signup_reward_amount")

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("intro_configs")
}

// ══════════════════════════════════════════════════════════════════
// [신통방통 복주머니 광고 적립 시스템] 2026-08
//
// 관리자가 광고(이미지/동영상/외부HTML/광고플랫폼)를 등록하고 보상/노출 조건을
// 설정하면, 앱 사용자가 시청 완료 시 서버 검증을 거쳐 복주머니(Wallet POINT)가
// 자동 적립되는 시스템. 새 장부를 만들지 않고 기존 luck-pouch-engine.ts의
// earnLuckPouch()를 그대로 호출해 지급한다(sourceType="AD_WATCH_REWARD").
//
// 설계 참고: OpenPassAdSource(광고소스 필드 패턴) + OpenPassAdRewardLog(중복지급
// 방지 idempotencyKey 패턴)를 그대로 재사용했다. 열림패스(UserPass) 대신
// 지급 대상이 Wallet(POINT)+PointHistory라는 점만 다르다.
//
// [일일상한 설계 결정 - 2026-08] AD_WATCH_REWARD는 luck-pouch-engine.ts의
// 전역 일일 적립 상한(80/120)에서 면제(CAP_EXEMPT_SOURCE_TYPES에 포함)된다.
// 광고 전용 일일 제한(perUserDailyLimit/dailyLimitReward)은 이 테이블
// (FortuneAdWatchLog)의 당일 rewardStatus=COMPLETED 카운트로 별도 체크한다.
// 활동점수(ACTIVITY_SCORE_WEIGHTS)에는 반영하지 않는다(순수 광고보상만 지급).
// ══════════════════════════════════════════════════════════════════

// ── FortuneAd: 관리자가 등록하는 광고 콘텐츠 + 보상/노출 설정 ──
model FortuneAd {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  // 유형: image/video/external/network(광고플랫폼 연동)
  adType String @map("ad_type")

  // 유형별 콘텐츠(사용하지 않는 필드는 null)
  imageUrl     String? @map("image_url")
  videoUrl     String? @map("video_url")
  externalUrl  String? @map("external_url")
  adSourceHtml String? @map("ad_source_html") // 광고플랫폼 연동 스크립트/HTML

  // 보상 설정
  rewardAmount Int @default(10) @map("reward_amount") // 1회 시청 보상(복주머니 개수)
  watchSeconds Int @default(15) @map("watch_seconds") // 최소 시청 시간(초), 서버 검증 기준

  // 노출/제한 설정
  isActive         Boolean   @default(true) @map("is_active")
  startAt          DateTime? @map("start_at")
  endAt            DateTime? @map("end_at")
  priority         Int       @default(0) @map("priority") // 낮을수록 먼저 노출
  perUserDailyLimit Int      @default(3) @map("per_user_daily_limit") // 회원당 하루 최대 시청 횟수
  dailyLimitReward Int?      @map("daily_limit_reward") // 광고 1건당 하루 최대 지급 총량(전체 유저 합산, null=무제한)

  status    String    @default("active") @map("status") // active/paused/deleted
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  watchLogs FortuneAdWatchLog[]

  @@index([isActive, status, priority])
  @@map("fortune_ads")
}

// ── FortuneAdWatchLog: 시청 시작~완료 이력 + 지급 상태(중복지급 방지) ──
model FortuneAdWatchLog {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  adId          Int      @map("ad_id")
  sessionId     String   @map("session_id") // start 호출 시 서버가 발급

  startedAt     DateTime  @default(now()) @map("started_at")
  completedAt   DateTime? @map("completed_at")
  watchSeconds  Int?      @map("watch_seconds") // 클라이언트가 보고한 실제 시청 시간(참고값, 최종판정은 서버)

  rewardAmount  Int      @default(0) @map("reward_amount") // 실제 지급된 금액(0=미지급)
  rewardStatus  String   @default("PENDING") @map("reward_status") // PENDING/COMPLETED/FAILED

  // 클라이언트가 start 시점에 생성해 매 요청에 동일하게 전달. complete 요청의 중복 처리를
  // 막는 유일한 근거(§원칙: 서버 최종지급 + 중복지급차단 idempotency).
  idempotencyKey String? @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")

  user User      @relation(fields: [userId], references: [id])
  ad   FortuneAd @relation(fields: [adId], references: [id])

  @@index([userId, adId, createdAt])
  @@index([adId, rewardStatus, createdAt])
  @@map("fortune_ad_watch_logs")
}
